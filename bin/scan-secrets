#!/usr/bin/env bash
#
# scan-secrets - fail closed if anything that looks like a credential is about
# to enter, or has already entered, the repository.
#
#   scan-secrets              scan tracked and staged files (default)
#   scan-secrets --history    scan every blob in the whole Git history
#   scan-secrets --all        scan every file in the working tree
#   scan-secrets --path DIR   scan a directory that is not a Git repository
#   scan-secrets --stdin      scan one text read from standard input
#
# Exit codes: 0 clean, 1 findings, 2 usage.
#
# The pattern list below is written with split string literals ('gh''p_') so
# that this file never matches its own rules.
set -uo pipefail

MODE=tracked
TARGET=""
while [ $# -gt 0 ]; do
    case $1 in
        --history) MODE=history; shift ;;
        --all)     MODE=all; shift ;;
        --path)    MODE=path; TARGET=${2:?--path needs a directory}; shift 2 ;;
        --stdin)   MODE=stdin; shift ;;
        --tracked) MODE=tracked; shift ;;
        -h|--help) sed -n '2,15p' "$0"; exit 0 ;;
        *) printf 'scan-secrets: unknown option: %s\n' "$1" >&2; exit 2 ;;
    esac
done

REPO_ROOT=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)
if [ "$MODE" != stdin ]; then
    cd -- "${TARGET:-$REPO_ROOT}" || exit 2
fi

RED=''; GREEN=''; DIM=''; RESET=''
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    RED=$'\033[31m'; GREEN=$'\033[32m'; DIM=$'\033[2m'; RESET=$'\033[0m'
fi

# --- content rules: <label>|<extended regex> --------------------------------
RULES=(
  "private key block|-----BEGIN ""[A-Z ]*PRIVATE KEY-----"
  "OpenSSH private key|-----BEGIN OPEN""SSH PRIVATE KEY-----"
  "PGP private key|-----BEGIN PGP ""PRIVATE KEY BLOCK-----"
  "GitHub personal token|gh""[pousr]_[A-Za-z0-9]{36,}"
  "GitHub fine-grained token|github""_pat_[A-Za-z0-9_]{22,}"
  "Anthropic API key|sk-""ant-[A-Za-z0-9_-]{20,}"
  "OpenAI API key|sk-""(proj|svcacct|admin)?-?[A-Za-z0-9_-]{32,}"
  "AWS access key id|AKIA""[0-9A-Z]{16}"
  "Slack token|xox""[abprs]-[A-Za-z0-9-]{10,}"
  "Google API key|AIza""[0-9A-Za-z_-]{35}"
  "bearer token header|[Aa]uthorization: *[Bb]earer +[A-Za-z0-9._-]{20,}"
  "JSON web token|ey""J[A-Za-z0-9_-]{10,}\.ey[A-Za-z0-9_-]{10,}\."
  "OAuth access token field|\"access_token\" *: *\"[A-Za-z0-9._-]{20,}"
  "OAuth refresh token field|\"refresh_token\" *: *\"[A-Za-z0-9._-]{20,}"
  "gh oauth token field|oauth_token: *[A-Za-z0-9_]{20,}"
  "generic api key assignment|(api[_-]?key|secret[_-]?key|client[_-]?secret) *[:=] *[\"']?[A-Za-z0-9/+_-]{24,}"
)

# --- path rules: filenames that must never be tracked -----------------------
PATH_RULES='(^|/)(\.credentials\.json|credentials\.json|auth\.json|hosts\.yml|\.netrc|netrc|id_(rsa|dsa|ecdsa|ed25519)|.*\.(pem|key|p12|pfx|kdbx|keystore|jks)|.*\.sqlite(-wal|-shm)?|\.claude\.json|installation_id)$'

FINDINGS=0
report() {
    printf '%sFINDING%s %s\n' "$RED" "$RESET" "$1"
    FINDINGS=$(( FINDINGS + 1 ))
}

scan_stream() {
    # $1 = label for the location, stdin = content
    local where=$1 rule label regex hit
    local content
    content=$(cat)
    for rule in "${RULES[@]}"; do
        label=${rule%%|*}
        regex=${rule#*|}
        hit=$(printf '%s' "$content" | grep -nEm1 -- "$regex" 2>/dev/null) || continue
        # Show the location and the rule, never the matched secret itself.
        report "$where: $label (line ${hit%%:*})"
    done
}

list_files() {
    case $MODE in
        tracked)
            git ls-files -z 2>/dev/null
            git diff --cached --name-only -z --diff-filter=ACMR 2>/dev/null
            ;;
        all|path)
            find . -type f -not -path './.git/*' -print0
            ;;
    esac
}

printf 'scan-secrets\n'
printf '  mode      %s\n' "$MODE"
printf '  root      %s\n\n' "$PWD"

if [ "$MODE" = stdin ]; then
    # One text, no file system. agentqueue reads the diff of a branch this way
    # before it pushes the branch: a push is publication, and a credential that
    # reached GitHub cannot be recalled by deleting the branch afterwards.
    scan_stream 'standard input'
    printf '%s1 text scanned%s\n' "$DIM" "$RESET"
elif [ "$MODE" = history ]; then
    if ! git rev-parse --git-dir >/dev/null 2>&1; then
        printf 'not a Git repository; nothing to scan\n'; exit 0
    fi
    count=0
    while read -r sha path; do
        [ -n "${sha:-}" ] || continue
        count=$(( count + 1 ))
        if printf '%s' "$path" | grep -qE "$PATH_RULES"; then
            report "history blob $path: filename matches a credential pattern"
        fi
        git cat-file blob "$sha" 2>/dev/null | scan_stream "history $path"
    done < <(git rev-list --objects --all 2>/dev/null |
             git cat-file --batch-check='%(objectname) %(objecttype) %(rest)' 2>/dev/null |
             awk '$2 == "blob" && $3 != "" { print $1, $3 }')
    printf '%s%d blob(s) scanned across all history%s\n' "$DIM" "$count" "$RESET"
else
    count=0
    while IFS= read -r -d '' f; do
        [ -f "$f" ] || continue
        case $f in ./.git/*|.git/*) continue ;; esac
        count=$(( count + 1 ))
        if printf '%s' "$f" | grep -qE "$PATH_RULES"; then
            report "$f: filename matches a credential pattern"
        fi
        # Skip binaries: a false positive there is noise, and no tracked file
        # in this repository is binary.
        if grep -qI . "$f" 2>/dev/null; then
            scan_stream "$f" < "$f"
        fi
    done < <(list_files | sort -zu)
    printf '%s%d file(s) scanned%s\n' "$DIM" "$count" "$RESET"
fi

printf '\n'
if [ "$FINDINGS" -eq 0 ]; then
    printf '%sclean: 0 findings%s\n' "$GREEN" "$RESET"
    exit 0
fi
printf '%s%d finding(s) - refusing to treat this as clean%s\n' "$RED" "$FINDINGS" "$RESET"
exit 1
