#!/usr/bin/env python3
"""Check or converge a GitHub repository to the canonical metadata manifest.

The manifest holds the "About" fields a reader sees, and the repository
settings that decide which surfaces exist and how a branch is merged.
"""

from __future__ import annotations

import argparse
import dataclasses
import json
import re
import subprocess
import sys
from pathlib import Path
from typing import Sequence

PROGRAM = "repo-meta"
ROOT = Path(__file__).resolve().parent.parent
DEFAULT_CONFIG = ROOT / "manifests" / "github-metadata.json"

# GitHub's own limits. A manifest that breaks one of them is refused here,
# where the message names the field, instead of failing later inside gh.
DESCRIPTION_LIMIT = 350
TOPIC_LIMIT = 20
TOPIC = re.compile(r"^[a-z0-9][a-z0-9-]{0,34}$")

# A branch name that git accepts and that needs no quoting anywhere.
BRANCH = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._/-]{0,254}$")

# Every repository setting this command manages, as
#   manifest key: (field of "gh repo view --json", flag of "gh repo edit").
# A setting outside this table is not managed: the manifest refuses to name it,
# and drift in it is neither reported nor repaired.
BOOLEAN_SETTINGS = {
    "has_issues": ("hasIssuesEnabled", "--enable-issues"),
    "has_wiki": ("hasWikiEnabled", "--enable-wiki"),
    "has_projects": ("hasProjectsEnabled", "--enable-projects"),
    "has_discussions": ("hasDiscussionsEnabled", "--enable-discussions"),
    "allow_merge_commit": ("mergeCommitAllowed", "--enable-merge-commit"),
    "allow_squash_merge": ("squashMergeAllowed", "--enable-squash-merge"),
    "allow_rebase_merge": ("rebaseMergeAllowed", "--enable-rebase-merge"),
    "delete_branch_on_merge": ("deleteBranchOnMerge", "--delete-branch-on-merge"),
}
DEFAULT_BRANCH = "default_branch"
MERGE_METHODS = ("allow_merge_commit", "allow_squash_merge", "allow_rebase_merge")
SETTING_KEYS = (DEFAULT_BRANCH, *BOOLEAN_SETTINGS)

# The JSON fields "gh repo view" must return for a complete reading.
VIEW_FIELDS = (
    "description",
    "homepageUrl",
    "repositoryTopics",
    "defaultBranchRef",
    *(field for field, _ in BOOLEAN_SETTINGS.values()),
)

EXIT_OK = 0
EXIT_DRIFT = 1
EXIT_USAGE = 2
EXIT_GH = 3
EXIT_REFUSED = 4
EXIT_VERIFY = 5


class ConfigError(ValueError):
    pass


class GitHubError(RuntimeError):
    pass


@dataclasses.dataclass(frozen=True)
class Metadata:
    description: str = ""
    homepage: str = ""
    topics: tuple[str, ...] = ()
    # Only the settings this side declares or reads. An empty mapping on the
    # desired side means the manifest manages no setting at all.
    settings: dict[str, object] = dataclasses.field(default_factory=dict)


@dataclasses.dataclass(frozen=True)
class Change:
    kind: str
    field: str
    before: str = ""
    after: str = ""

    @property
    def destructive(self) -> bool:
        """A change that removes something GitHub already offers a reader.

        Clearing a field and removing a topic remove public metadata. Disabling
        a feature removes a surface, and its content with it. Retargeting the
        default branch moves where every new clone and every new pull request
        lands. Each one needs a human.
        """
        return self.kind in {"CLEAR", "REMOVE", "DISABLE", "RETARGET"}


@dataclasses.dataclass(frozen=True)
class Plan:
    changes: tuple[Change, ...]

    @property
    def exact(self) -> bool:
        return not self.changes

    @property
    def destructive(self) -> tuple[Change, ...]:
        return tuple(change for change in self.changes if change.destructive)


def _text(value: object, field: str) -> str:
    if not isinstance(value, str):
        raise ConfigError(f"{field} must be a string")
    if value != value.strip():
        raise ConfigError(f"{field} must not have leading/trailing whitespace")
    if "\n" in value:
        raise ConfigError(f"{field} must be a single line")
    return value


def load_manifest(path: Path) -> Metadata:
    try:
        document = json.loads(path.read_text(encoding="utf-8"))
    except OSError as exc:
        raise ConfigError(f"cannot read {path}: {exc}") from exc
    except json.JSONDecodeError as exc:
        raise ConfigError(f"invalid JSON in {path}: {exc}") from exc
    if not isinstance(document, dict) or document.get("version") != 1:
        raise ConfigError("manifest version must be 1")

    description = _text(document.get("description", ""), "description")
    if len(description) > DESCRIPTION_LIMIT:
        raise ConfigError(
            f"description exceeds GitHub's {DESCRIPTION_LIMIT}-character limit"
        )

    homepage = _text(document.get("homepage", ""), "homepage")
    if homepage and not homepage.startswith(("http://", "https://")):
        raise ConfigError("homepage must be empty or an http(s) URL")

    raw = document.get("topics", [])
    if not isinstance(raw, list):
        raise ConfigError("manifest topics must be an array")
    if len(raw) > TOPIC_LIMIT:
        raise ConfigError(f"GitHub accepts at most {TOPIC_LIMIT} topics")
    topics = []
    for index, value in enumerate(raw):
        topic = _text(value, f"topics[{index}]")
        if not TOPIC.fullmatch(topic):
            raise ConfigError(
                f"topics[{index}] must be lowercase letters, digits or hyphens, "
                "start with a letter or digit, and be at most 35 characters: "
                f"{topic!r}"
            )
        if topic in topics:
            raise ConfigError(f"duplicate topics are not allowed: {topic!r}")
        topics.append(topic)

    return Metadata(
        description,
        homepage,
        tuple(sorted(topics)),
        _settings(document.get("settings", {})),
    )


def _settings(value: object) -> dict[str, object]:
    """Read the manifest settings block, and refuse anything GitHub would."""
    if not isinstance(value, dict):
        raise ConfigError("manifest settings must be an object")

    settings: dict[str, object] = {}
    for key, raw in value.items():
        if key not in SETTING_KEYS:
            raise ConfigError(
                f"settings.{key} is not a managed setting; "
                f"managed settings are {', '.join(sorted(SETTING_KEYS))}"
            )
        if key == DEFAULT_BRANCH:
            branch = _text(raw, f"settings.{key}")
            if not BRANCH.fullmatch(branch):
                raise ConfigError(
                    f"settings.{key} must be a branch name of letters, digits, "
                    f"'.', '_', '-' or '/', starting with a letter or a digit: {branch!r}"
                )
            settings[key] = branch
            continue
        # bool is a subclass of int, so 1 and 0 must not pass as true and false.
        if type(raw) is not bool:
            raise ConfigError(f"settings.{key} must be true or false")
        settings[key] = raw

    declared = [key for key in MERGE_METHODS if key in settings]
    if len(declared) == len(MERGE_METHODS) and not any(settings[k] for k in declared):
        raise ConfigError("GitHub needs at least one merge method enabled")

    return settings


def metadata_from_github(value: object) -> Metadata:
    if not isinstance(value, dict):
        raise GitHubError("gh returned an unexpected repository document")
    description = value.get("description") or ""
    homepage = value.get("homepageUrl") or ""
    raw = value.get("repositoryTopics") or []
    if not isinstance(raw, list):
        raise GitHubError("gh returned an unexpected topic list")
    topics = []
    for index, item in enumerate(raw):
        if not isinstance(item, dict) or not isinstance(item.get("name"), str):
            raise GitHubError(f"gh topic result {index} has no name")
        topics.append(item["name"])

    settings: dict[str, object] = {}
    branch = value.get("defaultBranchRef")
    if isinstance(branch, dict) and isinstance(branch.get("name"), str):
        settings[DEFAULT_BRANCH] = branch["name"]
    for key, (field, _) in BOOLEAN_SETTINGS.items():
        current = value.get(field)
        if isinstance(current, bool):
            settings[key] = current

    return Metadata(str(description), str(homepage), tuple(sorted(topics)), settings)


def build_plan(desired: Metadata, current: Metadata) -> Plan:
    changes: list[Change] = []

    for field in ("description", "homepage"):
        want = getattr(desired, field)
        have = getattr(current, field)
        if want == have:
            continue
        kind = "SET" if want else "CLEAR"
        changes.append(Change(kind, field, before=have, after=want))

    for topic in desired.topics:
        if topic not in current.topics:
            changes.append(Change("ADD", "topic", after=topic))
    for topic in current.topics:
        if topic not in desired.topics:
            changes.append(Change("REMOVE", "topic", before=topic))

    # A setting the manifest does not declare is not managed, so it is not
    # compared. A setting it declares that GitHub did not answer for is drift
    # this side cannot repair, and saying so beats guessing.
    for key in SETTING_KEYS:
        if key not in desired.settings:
            continue
        want = desired.settings[key]
        if key not in current.settings:
            changes.append(Change("UNKNOWN", key, after=_setting_text(want)))
        elif current.settings[key] != want:
            if key == DEFAULT_BRANCH:
                kind = "RETARGET"
            else:
                kind = "ENABLE" if want else "DISABLE"
            changes.append(Change(
                kind, key,
                before=_setting_text(current.settings[key]),
                after=_setting_text(want),
            ))

    return Plan(tuple(changes))


def _run_gh(args: Sequence[str]) -> str:
    try:
        proc = subprocess.run(
            ["gh", *args], capture_output=True, text=True, check=False,
        )
    except FileNotFoundError as exc:
        raise GitHubError("gh is not installed or is not on PATH") from exc
    if proc.returncode != 0:
        detail = proc.stderr.strip() or proc.stdout.strip() or f"exit {proc.returncode}"
        raise GitHubError(f"gh {' '.join(args[:2])} failed: {detail}")
    return proc.stdout


def resolve_repo(explicit: str | None) -> str:
    if explicit:
        if explicit.count("/") != 1 or any(not part for part in explicit.split("/")):
            raise ConfigError("--repo must be OWNER/NAME")
        return explicit
    value = _run_gh(["repo", "view", "--json", "nameWithOwner", "--jq", ".nameWithOwner"]).strip()
    if value.count("/") != 1:
        raise GitHubError("cannot resolve the current GitHub repository")
    return value


def read_current(repo: str) -> Metadata:
    raw = _run_gh(["repo", "view", repo, "--json", ",".join(VIEW_FIELDS)])
    try:
        return metadata_from_github(json.loads(raw))
    except json.JSONDecodeError as exc:
        raise GitHubError(f"gh returned invalid JSON for {repo}: {exc}") from exc


def _shown(value: str) -> str:
    return value if value else "(empty)"


def _setting_text(value: object) -> str:
    if isinstance(value, bool):
        return "on" if value else "off"
    return str(value)


def render_plan(plan: Plan) -> str:
    lines = []
    for change in plan.changes:
        if change.kind in {"SET", "CLEAR", "ENABLE", "DISABLE", "RETARGET"}:
            lines.append(
                f"{change.kind:<8} {change.field}  "
                f"{_shown(change.before)} -> {_shown(change.after)}"
            )
        elif change.kind == "UNKNOWN":
            lines.append(
                f"{change.kind:<8} {change.field}  "
                f"gh did not report it; wanted {_shown(change.after)}"
            )
        else:
            lines.append(f"{change.kind:<8} {change.field}  {change.before}{change.after}")
    return "\n".join(lines)


def _confirm_destructive(plan: Plan, assume_yes: bool, stdin) -> bool:
    removals = plan.destructive
    if not removals or assume_yes:
        return True
    if not getattr(stdin, "isatty", lambda: False)():
        return False
    names = ", ".join(f"{change.kind.lower()} {change.field}" for change in removals)
    print(f"{PROGRAM}: sync will remove public metadata: {names}", file=sys.stderr)
    answer = input("Continue with destructive metadata sync? [y/N] ").strip().casefold()
    return answer in {"y", "yes"}


def apply_plan(repo: str, plan: Plan) -> None:
    # The About fields go in one edit; the topic set goes in another. gh takes
    # each value as its own argument, so no value is ever parsed by a shell.
    fields: list[str] = []
    for change in plan.changes:
        if change.kind in {"SET", "CLEAR"}:
            fields += [f"--{change.field}", change.after]
    if fields:
        _run_gh(["repo", "edit", repo, *fields])

    adds = [change.after for change in plan.changes if change.kind == "ADD"]
    removes = [change.before for change in plan.changes if change.kind == "REMOVE"]
    topics: list[str] = []
    if adds:
        topics += ["--add-topic", ",".join(adds)]
    if removes:
        topics += ["--remove-topic", ",".join(removes)]
    if topics:
        _run_gh(["repo", "edit", repo, *topics])

    # The settings go in a third edit, so a failure names the half that failed.
    # A setting gh did not report is not written: this side does not know what
    # it would overwrite.
    flags: list[str] = []
    for change in plan.changes:
        if change.kind == "RETARGET":
            flags += ["--default-branch", change.after]
        elif change.kind in {"ENABLE", "DISABLE"}:
            flag = BOOLEAN_SETTINGS[change.field][1]
            flags.append(f"{flag}={'true' if change.kind == 'ENABLE' else 'false'}")
    if flags:
        _run_gh(["repo", "edit", repo, *flags])


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=PROGRAM,
        description="Check or sync the repository About metadata and settings exactly.",
    )
    sub = parser.add_subparsers(dest="command", required=True)
    for name in ("check", "sync"):
        command = sub.add_parser(name)
        command.add_argument("--repo", help="target repository as OWNER/NAME; default: current repository")
        command.add_argument("--config", type=Path, default=DEFAULT_CONFIG,
                             help=f"metadata manifest (default: {DEFAULT_CONFIG})")
        if name == "sync":
            command.add_argument("--dry-run", action="store_true", help="show the exact plan and change nothing")
            command.add_argument("--yes", action="store_true", help="allow destructive non-interactive sync")
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        desired = load_manifest(args.config)
        repo = resolve_repo(args.repo)
        current = read_current(repo)
        plan = build_plan(desired, current)
    except ConfigError as exc:
        print(f"{PROGRAM}: {exc}", file=sys.stderr)
        return EXIT_USAGE
    except GitHubError as exc:
        print(f"{PROGRAM}: {exc}", file=sys.stderr)
        return EXIT_GH

    print(f"{PROGRAM}: {repo}")
    if plan.exact:
        print("metadata matches the manifest exactly")
        return EXIT_OK

    print(render_plan(plan))
    print(f"summary: {len(plan.changes)} change(s), {len(plan.destructive)} removing metadata")

    if args.command == "check":
        return EXIT_DRIFT
    if args.dry_run:
        return EXIT_OK
    if not _confirm_destructive(plan, args.yes, sys.stdin):
        print(f"{PROGRAM}: refused destructive sync; re-run interactively or pass --yes", file=sys.stderr)
        return EXIT_REFUSED

    try:
        apply_plan(repo, plan)
        remaining = build_plan(desired, read_current(repo))
    except GitHubError as exc:
        print(f"{PROGRAM}: {exc}", file=sys.stderr)
        return EXIT_GH
    if not remaining.exact:
        print(f"{PROGRAM}: repository still differs after sync", file=sys.stderr)
        print(render_plan(remaining), file=sys.stderr)
        return EXIT_VERIFY

    print("sync complete; metadata matches the manifest exactly")
    return EXIT_OK


if __name__ == "__main__":
    raise SystemExit(main())
