#!/usr/bin/env bash
# Show controls for the running Android Emulator in android-dev.
set -euo pipefail

SDK_ROOT=${ANDROID_HOME:-$HOME/android-sdk}
ADB=$SDK_ROOT/platform-tools/adb

if [ ! -x "$ADB" ]; then
    if command -v devbox >/dev/null 2>&1; then
        exec devbox exec android-dev -- android-emulator-controls "$@"
    fi
    printf 'Android platform-tools are not installed in android-dev\n' >&2
    exit 1
fi

case ${1:-show} in
    --check)
        command -v yad >/dev/null 2>&1 || {
            printf 'yad is not installed in android-dev\n' >&2
            exit 1
        }
        "$ADB" version >/dev/null
        ;;
    back|home|overview|power|volume-up|volume-down)
        case $1 in
            back) key=KEYCODE_BACK ;;
            home) key=KEYCODE_HOME ;;
            overview) key=KEYCODE_APP_SWITCH ;;
            power) key=KEYCODE_POWER ;;
            volume-up) key=KEYCODE_VOLUME_UP ;;
            volume-down) key=KEYCODE_VOLUME_DOWN ;;
        esac
        "$ADB" -e shell input keyevent "$key"
        ;;
    rotate)
        "$ADB" -e emu rotate
        ;;
    screenshot)
        pictures=${XDG_PICTURES_DIR:-$HOME/Pictures}
        mkdir -p "$pictures"
        file=$(mktemp "$pictures/android-emulator-XXXXXXXX.png")
        if ! "$ADB" -e exec-out screencap -p > "$file"; then
            rm -f -- "$file"
            exit 1
        fi
        printf '%s\n' "$file"
        ;;
    show)
        command -v yad >/dev/null 2>&1 || {
            printf 'yad is not installed in android-dev\n' >&2
            exit 1
        }
        "$ADB" -e get-state >/dev/null
        printf -v self '%q' "$(readlink -f -- "$0")"
        exec yad --form --title='Android controls' --text='Android Emulator' \
            --width=340 --columns=2 --no-buttons \
            --field='Back:FBTN' "$self back" \
            --field='Home:FBTN' "$self home" \
            --field='Overview:FBTN' "$self overview" \
            --field='Power:FBTN' "$self power" \
            --field='Volume up:FBTN' "$self volume-up" \
            --field='Volume down:FBTN' "$self volume-down" \
            --field='Rotate:FBTN' "$self rotate" \
            --field='Screenshot:FBTN' "$self screenshot"
        ;;
    *)
        printf 'usage: android-emulator-controls [show|back|home|overview|power|volume-up|volume-down|rotate|screenshot|--check]\n' >&2
        exit 2
        ;;
esac
