#!/usr/bin/env bash
#
# devbox-verify - deterministic verification of the Orca -> agent -> Distrobox
# routing setup. Safe to re-run: it only ever writes inside a scratch directory
# and a throwaway copy of the router configuration.
#
#   devbox-verify           run everything
#   devbox-verify --fast    skip the tests that actually launch claude/codex

set -uo pipefail

DEVBOX=${DEVBOX_BIN:-$HOME/.local/bin/devbox}
SHIM_DIR=$HOME/.local/bin
REAL_CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}/devbox-router
PROJECTS=$HOME/projects
PRIMARY_REPO=$PROJECTS/dkkb
FAST=0
[[ ${1:-} == --fast ]] && FAST=1

PASSED=0; FAILED=0; SKIPPED=0
canon() { realpath -m -- "$1"; }

t_pass() { printf '  PASS  %s\n' "$1"; PASSED=$(( PASSED + 1 )); }
t_fail() {
    local name=$1; shift
    printf '  FAIL  %s\n' "$name"
    local l; for l in "$@"; do printf '          %s\n' "$l"; done
    FAILED=$(( FAILED + 1 ))
}
t_skip() { printf '  SKIP  %s  (%s)\n' "$1" "$2"; SKIPPED=$(( SKIPPED + 1 )); }

expect_eq() {
    local name=$1 want=$2 got=$3
    [[ $want == "$got" ]] && { t_pass "$name"; return 0; }
    t_fail "$name" "expected: [$want]" "actual:   [$got]"
    return 1
}
expect_contains() {
    local name=$1 needle=$2 hay=$3
    [[ $hay == *"$needle"* ]] && { t_pass "$name"; return 0; }
    t_fail "$name" "expected to contain: [$needle]" "actual: ${hay//$'\n'/ | }"
    return 1
}
expect_rc() {
    local name=$1 want=$2 got=$3 out=${4:-}
    [[ $want == "$got" ]] && { t_pass "$name"; return 0; }
    t_fail "$name" "expected exit $want, got $got" "output: ${out//$'\n'/ | }"
    return 1
}
section() { printf '\n%s\n' "$1"; }

# ------------------------------------------------------------------ scratch --

SCRATCH=$PROJECTS/.devbox-verify.tmp
CFG=""
cleanup() {
    [[ -n ${SCRATCH:-} && -d $SCRATCH ]] || return 0
    chmod -R u+w -- "$SCRATCH" 2>/dev/null || true
    rm -rf -- "$SCRATCH"
}
trap cleanup EXIT INT TERM

[[ -x $DEVBOX ]] || { printf 'devbox-verify: router not found: %s\n' "$DEVBOX" >&2; exit 1; }
[[ -d $PROJECTS ]] || { printf 'devbox-verify: %s does not exist\n' "$PROJECTS" >&2; exit 1; }

rm -rf -- "$SCRATCH"
mkdir -p -- "$SCRATCH"
CFG=$SCRATCH/config
cp -a -- "$REAL_CONFIG" "$CFG"
rm -rf -- "$CFG/backups"

# Throwaway environments used by the isolated tests.
cat > "$CFG/environments.d/verify-alt.env" <<'EOF'
description = throwaway environment for devbox-verify
box = web-dev
workspace_host = ~/projects
workspace_guest = /workspace
EOF
cat > "$CFG/environments.d/verify-missing.env" <<'EOF'
description = points at a container that does not exist
box = devbox-verify-absent-container
EOF
# Keep the inferred dotnet case deterministic even when the real environment exists.
sed -i 's/^box = dotnet-dev$/box = devbox-verify-absent-container/' \
    "$CFG/environments.d/dotnet-dev.env"

mkrepo() {
    local dir=$1; shift
    mkdir -p -- "$dir"
    git -C "$dir" init -q -b main
    git -C "$dir" config user.email verify@localhost
    git -C "$dir" config user.name  devbox-verify
    local f
    for f in "$@"; do printf '{}\n' > "$dir/$f"; done
    git -C "$dir" add -A >/dev/null 2>&1
    git -C "$dir" commit -q --allow-empty -m init >/dev/null 2>&1
}

dbx()      { "$DEVBOX" "$@"; }
dbx_cfg()  { DEVBOX_CONFIG_HOME=$CFG "$DEVBOX" "$@"; }

printf '== devbox routing verification ==\n'
printf 'router      %s\n' "$DEVBOX"
printf 'config      %s\n' "$REAL_CONFIG"
printf 'scratch     %s\n' "$SCRATCH"

# ------------------------------------------------ A: primary checkout ------

section 'A. primary checkout resolves to web-dev'
if [[ -d $PRIMARY_REPO/.git ]]; then
    out=$(cd "$PRIMARY_REPO" && dbx resolve 2>&1); rc=$?
    expect_rc 'A1 devbox resolve exits 0' 0 "$rc" "$out" && expect_eq 'A2 environment is web-dev' web-dev "$out"
    out=$(cd "$PRIMARY_REPO" && dbx where --porcelain 2>&1)
    expect_contains 'A3 source is the global assignment' $'source\tglobal' "$out"
else
    t_skip 'A primary checkout' "$PRIMARY_REPO is not a Git repository"
fi

# ------------------------------------------------ B/L: Orca worktree -------

section 'B/L. Orca worktree inherits its primary checkout (git-common-dir)'
WT=""
if [[ -d $PROJECTS/.worktrees/dkkb ]]; then
    while IFS= read -r d; do [[ -e $d/.git ]] && { WT=$d; break; }; done \
        < <(find "$PROJECTS/.worktrees/dkkb" -mindepth 1 -maxdepth 1 -type d 2>/dev/null)
fi
if [[ -n $WT ]]; then
    out=$(cd "$WT" && dbx resolve 2>&1); rc=$?
    expect_rc 'B1 worktree resolves' 0 "$rc" "$out" && expect_eq 'B2 worktree -> web-dev' web-dev "$out"
    out=$(dbx where --porcelain "$WT" 2>&1)
    expect_contains 'L1 repo_root is the primary checkout' $'repo_root\t'"$(canon "$PRIMARY_REPO")" "$out"
    expect_contains 'L2 git_common_dir is the primary .git' $'git_common_dir\t'"$(canon "$PRIMARY_REPO")/.git" "$out"
    expect_contains 'B3 no separate mapping needed (source=global)' $'source\tglobal' "$out"
else
    t_skip 'B/L Orca worktree' 'no Orca worktree of dkkb present'
fi

# synthetic worktree: proves inheritance without depending on Orca
mkrepo "$SCRATCH/owner" package.json
git -C "$SCRATCH/owner" worktree add -q -b verify-wt "$SCRATCH/wt" >/dev/null 2>&1
dbx_cfg assign verify-alt "$SCRATCH/owner" >/dev/null 2>&1
out=$(dbx_cfg where --porcelain "$SCRATCH/wt" 2>&1)
expect_contains 'L3 synthetic worktree inherits owner assignment' $'env\tverify-alt' "$out"
expect_contains 'L4 synthetic worktree repo_root is the owner' $'repo_root\t'"$(canon "$SCRATCH/owner")" "$out"

# ------------------------------------------------ C: path translation ------

section 'C. host path -> container path translation'
expect_eq 'C1 ~/projects root'        '/workspace'          "$(dbx path web-dev "$PROJECTS")"
expect_eq 'C2 repo under ~/projects'  '/workspace/dkkb'     "$(dbx path web-dev "$PROJECTS/dkkb")"
expect_eq 'C3 path with spaces'       '/workspace/a b/c d'  "$(dbx path web-dev "$PROJECTS/a b/c d")"
# Every spelling of the home directory must collapse to the same container
# path. The spellings are derived from $HOME, so this suite never names one
# machine's user. A spelling that this machine does not have is skipped.
for spelling in "/home/${HOME##*/}" "/var/home/${HOME##*/}"; do
    label=$([[ $spelling == /var/* ]] && echo 'C5 /var/home spelling' || echo 'C4 /home spelling')
    if [[ $(canon "$spelling") == "$(canon "$HOME")" ]]; then
        expect_eq "$label" '/workspace/dkkb' "$(dbx path web-dev "$spelling/projects/dkkb")"
    else
        t_skip "$label" "this machine has no $spelling"
    fi
done
expect_eq 'C6 outside workspace'      "/run/host$(canon "$HOME")/.config" "$(dbx path web-dev "$HOME/.config")"

# ------------------------------------------------ D: toolchain -------------

section 'D. Node and pnpm resolve from web-dev in a dkkb worktree'
DIR=${WT:-$PRIMARY_REPO}
if [[ -d $DIR ]]; then
    out=$(cd "$DIR" && dbx run -- bash -lc 'printf "%s|%s|%s" "$(node -v)" "$(pnpm -v)" "$(pwd)"' 2>&1); rc=$?
    if (( rc == 0 )); then
        expect_contains 'D1 Node comes from the box'  'v22.'          "$out"
        expect_contains 'D2 pnpm is available'        '|11.'          "$out"
        expect_contains 'D3 cwd was translated'       '|/workspace/'  "$out"
    else
        t_fail 'D devbox run in worktree' "exit $rc" "$out"
    fi
    out=$(cd "$DIR" && dbx run -- bash -lc 'command -v node' 2>&1)
    expect_contains 'D4 node binary lives in the box home' 'distrobox-homes/web-dev' "$out"
else
    t_skip 'D toolchain' 'no dkkb checkout'
fi

# ------------------------------------------------ E/F: agent shims ---------

section 'E/F. claude and codex resolve to the web-dev binaries'
if [[ -d $DIR ]]; then
    out=$(cd "$DIR" && dbx run -- bash -lc 'command -v claude' 2>&1)
    expect_contains 'E1 claude binary in the box home' 'distrobox-homes/web-dev' "$out"
    out=$(cd "$DIR" && dbx run -- bash -lc 'command -v codex' 2>&1)
    expect_contains 'F1 codex binary in the box home'  'distrobox-homes/web-dev' "$out"

    out=$(cd "$DIR" && DEVBOX_DRY_RUN=1 "$SHIM_DIR/claude" --version 2>&1)
    expect_contains 'E2 host claude shim routes to web-dev' $'env=web-dev' "$out"
    expect_contains 'E3 host claude shim passes argv'       $'argv[0]=claude' "$out"
    expect_contains 'E4 host claude shim translates cwd'    'guest_cwd=/workspace/' "$out"
    out=$(cd "$DIR" && DEVBOX_DRY_RUN=1 "$SHIM_DIR/codex" exec 'a b' 2>&1)
    expect_contains 'F2 host codex shim routes to web-dev'  $'env=web-dev' "$out"
    expect_contains 'F3 host codex shim preserves spaces'   $'argv[2]=a b' "$out"

    if (( FAST )); then
        t_skip 'E5/F4 real agent launch' '--fast'
    else
        out=$("$SHIM_DIR/claude" --version 2>&1 </dev/null); rc=$?
        expect_rc 'E5 claude --version through the host shim' 0 "$rc" "$out"
        out=$("$SHIM_DIR/codex" --version 2>&1 </dev/null); rc=$?
        expect_rc 'F4 codex --version through the host shim' 0 "$rc" "$out"
    fi
else
    t_skip 'E/F agent shims' 'no dkkb checkout'
fi

# ------------------------------------------------ G: outside a repo --------

section 'G. agents outside a Git repository use the management environment'
OUTSIDE=$SCRATCH/not-a-repo
mkdir -p -- "$OUTSIDE"
out=$(cd "$OUTSIDE" && DEVBOX_DRY_RUN=1 "$SHIM_DIR/claude" 2>&1); rc=$?
expect_rc 'G1 claude shim succeeds outside a repo' 0 "$rc" "$out"
expect_contains 'G2 falls back to web-dev'    $'env=web-dev' "$out"
expect_contains 'G3 source is the default'    $'source=default' "$out"
out=$(cd "$OUTSIDE" && DEVBOX_DRY_RUN=1 "$SHIM_DIR/codex" 2>&1)
expect_contains 'G4 codex shim falls back too' $'env=web-dev' "$out"
out=$(cd "$OUTSIDE" && dbx run -- true 2>&1); rc=$?
expect_rc 'G5 devbox run still refuses outside a repo' 3 "$rc" "$out"

# ------------------------------------------------ H: unknown repo ----------

section 'H. unconfigured repository fails deterministically'
mkrepo "$SCRATCH/unknown" README.md
out=$(cd "$SCRATCH/unknown" && dbx_cfg run -- true 2>&1); rc=$?
expect_rc 'H1 exits 4 (unresolved)' 4 "$rc" "$out"
expect_contains 'H2 error names the repository' "$(canon "$SCRATCH/unknown")" "$out"
expect_contains 'H3 error suggests devbox assign' 'devbox assign' "$out"

mkrepo "$SCRATCH/dotnetish" global.json
out=$(cd "$SCRATCH/dotnetish" && dbx_cfg run -- true 2>&1); rc=$?
expect_rc 'H4 inferred environment with a missing container exits 6' 6 "$rc" "$out"
expect_contains 'H5 error names the inferred environment' 'dotnet-dev' "$out"

mkrepo "$SCRATCH/mixed" package.json Cargo.toml
out=$(cd "$SCRATCH/mixed" && dbx_cfg run -- true 2>&1); rc=$?
expect_rc 'H6 ambiguous repo exits 7' 7 "$rc" "$out"
expect_contains 'H7 ambiguity lists candidates' 'web-dev' "$out"

# ------------------------------------------------ I: missing container -----

section 'I. missing Distrobox produces a clear error'
out=$(dbx_cfg exec verify-missing -- true 2>&1); rc=$?
expect_rc 'I1 exits 6' 6 "$rc" "$out"
expect_contains 'I2 names the missing container' 'devbox-verify-absent-container' "$out"
expect_contains 'I3 suggests distrobox create' 'distrobox create' "$out"
out=$(dbx_cfg check verify-missing 2>&1); rc=$?
expect_rc 'I4 devbox check reports it' 6 "$rc" "$out"
out=$(dbx_cfg exec no-such-environment -- true 2>&1); rc=$?
expect_rc 'I5 unknown environment exits 5' 5 "$rc" "$out"

# ------------------------------------------------ J: spaces + argv ---------

section 'J. paths with spaces and exact argv preservation'
SPACED="$SCRATCH/re po/my project"
mkrepo "$SPACED" package.json
dbx_cfg assign web-dev "$SPACED" >/dev/null 2>&1
out=$(cd "$SPACED" && dbx_cfg run -- bash -lc 'pwd' 2>&1); rc=$?
expect_rc 'J1 runs from a path with spaces' 0 "$rc" "$out"
expect_eq  'J2 guest cwd keeps the spaces' \
    "/workspace/.devbox-verify.tmp/re po/my project" "$out"
out=$(cd "$SPACED" && dbx_cfg run -- printf '[%s]' 'a b' "c'd" 'e"f' 'g$h' 'i*j' 'k;l' '$(id)' '`id`' '' 2>&1)
expect_eq 'J3 argv survives verbatim' "[a b][c'd][e\"f][g\$h][i*j][k;l][\$(id)][\`id\`][]" "$out"
out=$(cd "$SPACED" && dbx_cfg run -- bash -c 'printf "%s" "$1"' _ "$(printf 'x\ny')" 2>&1)
expect_eq 'J4 newlines survive' "$(printf 'x\ny')" "$out"

# ------------------------------------------------ K: precedence ------------

section 'K. explicit configuration cannot be overridden by inference'
mkrepo "$SCRATCH/nodeish" package.json pnpm-workspace.yaml
out=$(cd "$SCRATCH/nodeish" && dbx_cfg where --porcelain 2>&1)
expect_contains 'K1 inference finds web-dev when unassigned' $'source\tinferred' "$out"
dbx_cfg assign verify-alt "$SCRATCH/nodeish" >/dev/null 2>&1
out=$(cd "$SCRATCH/nodeish" && dbx_cfg where --porcelain 2>&1)
expect_contains 'K2 explicit assignment wins over inference' $'env\tverify-alt' "$out"
expect_contains 'K3 source is the global assignment'         $'source\tglobal' "$out"
out=$(dbx_cfg assign web-dev "$SCRATCH/nodeish" 2>&1); rc=$?
expect_rc 'K4 reassignment without --force is refused' 8 "$rc" "$out"
out=$(cd "$SCRATCH/nodeish" && dbx_cfg resolve 2>&1)
expect_eq 'K5 refused reassignment changed nothing' verify-alt "$out"
out=$(dbx_cfg assign web-dev "$SCRATCH/nodeish" --force 2>&1); rc=$?
expect_rc 'K6 --force reassigns' 0 "$rc" "$out"
expect_eq 'K7 assignment now web-dev' web-dev "$(cd "$SCRATCH/nodeish" && dbx_cfg resolve 2>&1)"

printf 'verify-alt\n' > "$SCRATCH/nodeish/.devbox"
out=$(cd "$SCRATCH/nodeish" && dbx_cfg where --porcelain 2>&1)
expect_contains 'K8 repo-local .devbox outranks the global assignment' $'source\trepo-file' "$out"
rm -f -- "$SCRATCH/nodeish/.devbox"
printf 'verify-alt\n' > "$SCRATCH/nodeish/.git/devbox-env"
out=$(cd "$SCRATCH/nodeish" && dbx_cfg where --porcelain 2>&1)
expect_contains 'K9 per-clone devbox-env outranks the global assignment' $'source\tclone-local' "$out"
rm -f -- "$SCRATCH/nodeish/.git/devbox-env"
out=$(cd "$SCRATCH/nodeish" && DEVBOX_ENV=verify-alt dbx_cfg where --porcelain 2>&1)
expect_contains 'K10 DEVBOX_ENV outranks everything' $'source\toverride' "$out"
out=$(cd "$SCRATCH/nodeish" && dbx_cfg unassign 2>&1); rc=$?
expect_rc 'K11 unassign succeeds' 0 "$rc" "$out"
out=$(cd "$SCRATCH/nodeish" && dbx_cfg where --porcelain 2>&1)
expect_contains 'K12 falls back to inference after unassign' $'source\tinferred' "$out"

# ------------------------------------------------ M: recursion guard -------

section 'M. recursion and PATH hygiene'
out=$(DEVBOX_ACTIVE_ENV=web-dev "$DEVBOX" run -- true 2>&1); rc=$?
expect_rc 'M1 router refuses to run inside an environment' 8 "$rc" "$out"
out=$(DEVBOX_ACTIVE_ENV=web-dev "$SHIM_DIR/claude" --version 2>&1); rc=$?
expect_rc 'M2 claude shim refuses inside an environment' 8 "$rc" "$out"
out=$(DEVBOX_ACTIVE_ENV=web-dev "$SHIM_DIR/codex" --version 2>&1); rc=$?
expect_rc 'M3 codex shim refuses inside an environment' 8 "$rc" "$out"
out=$(dbx exec web-dev -- bash -lc 'case ":$PATH:" in *":'"$SHIM_DIR"':"*) echo LEAK ;; *) echo CLEAN ;; esac' 2>&1)
expect_eq 'M4 host shim dir is stripped from the container PATH' CLEAN "$out"
out=$(dbx exec web-dev -- bash -lc 'printf %s "${DEVBOX_ACTIVE_ENV:-unset}"' 2>&1)
expect_eq 'M5 container is marked as an active environment' web-dev "$out"
out=$(dbx exec web-dev -- definitely-not-a-real-command 2>&1); rc=$?
expect_rc 'M6 missing in-container command exits 127' 127 "$rc" "$out"

# ------------------------------------------------ N: compat wrappers -------

section 'N. compatibility wrappers and management commands'
if [[ -d $DIR ]]; then
    out=$(cd "$DIR" && DEVBOX_DRY_RUN=1 "$SHIM_DIR/devbox-run" true 2>&1)
    expect_contains 'N1 devbox-run still routes' $'env=web-dev' "$out"
fi
out=$("$SHIM_DIR/web-dev-run" bash -lc 'pwd' 2>&1 </dev/null); rc=$?
expect_rc 'N2 web-dev-run still works' 0 "$rc" "$out"
out=$(dbx check 2>&1); rc=$?
expect_rc 'N3 devbox check passes for real environments' 0 "$rc" "$out"
out=$(dbx list 2>&1)
expect_contains 'N4 devbox list shows web-dev' 'web-dev' "$out"
out=$(dbx doctor "$PRIMARY_REPO" 2>&1); rc=$?
expect_rc 'N5 devbox doctor runs' 0 "$rc" "$out"
expect_contains 'N6 doctor reports in-box tools' 'distrobox-homes/web-dev' "$out"

# ------------------------------------------------ O: pinned host shims -----

section 'O. pinned host shims (devbox new-shim --env)'
#
# A resolved shim asks the repository which environment owns it. A pinned shim
# does not: the tool is installed in ONE environment, so the working directory
# decides the path and never the destination. agentq is the first user.
#
# The shims below are written into the scratch directory, so the real
# ~/.local/bin is untouched.

SHIMS=$SCRATCH/shims
mkdir -p -- "$SHIMS"
# A variable assignment in front of a real command does not survive it, so
# neither helper leaks its settings into the rest of this suite.
mkshim()  { DEVBOX_SHIM_DIR=$SHIMS "$DEVBOX" new-shim "$@" >/dev/null 2>&1; }
# The shims must see the throwaway configuration and this router, exactly as an
# installed shim sees the real ones.
runshim() { DEVBOX_CONFIG_HOME=$CFG DEVBOX_BIN=$DEVBOX "$SHIMS/$1" "${@:2}"; }

mkshim env   --env verify-alt
mkshim false --env verify-alt
out=$(DEVBOX_SHIM_DIR=$SHIMS "$DEVBOX" new-shim env --env verify-alt 2>&1); rc=$?
expect_rc 'O1 new-shim refuses to overwrite an existing shim' 8 "$rc" "$out"

# Generation is reproducible: the installed file is what --print prints today.
expect_eq 'O2 the installed shim is exactly what --print generates' \
    "$(dbx new-shim env --env verify-alt --print 2>/dev/null)" "$(cat "$SHIMS/env")"

# The pin wins over repository resolution. $SCRATCH/nodeish infers web-dev on
# its own; through a shim pinned to verify-alt it must reach verify-alt.
out=$(cd "$SCRATCH/nodeish" && DEVBOX_DRY_RUN=1 runshim env 2>&1)
expect_contains 'O3 a pinned shim ignores the repository environment' $'env=verify-alt' "$out"
expect_contains 'O4 the pin is explicit, not resolved'               $'source=explicit' "$out"
out=$(cd "$SCRATCH/nodeish" && dbx_cfg where --porcelain 2>&1)
expect_contains 'O5 the same directory resolves elsewhere on its own' $'env\tweb-dev' "$out"

# The working directory crosses the boundary, and so does argv.
out=$(cd "$SPACED" && DEVBOX_DRY_RUN=1 runshim env 2>&1)
expect_contains 'O6 a pinned shim translates the working directory' \
    'guest_cwd=/workspace/.devbox-verify.tmp/re po/my project' "$out"
out=$(cd "$PROJECTS" && DEVBOX_DRY_RUN=1 runshim env --repo . 'a b' 2>&1)
expect_contains 'O7 argv[0] is the tool, not the shim' $'argv[0]=env' "$out"
expect_contains 'O8 a relative path reaches the tool unchanged' $'argv[1]=--repo' "$out"
expect_contains 'O9 argv keeps a dot'    $'argv[2]=.' "$out"
expect_contains 'O10 argv keeps a space' $'argv[3]=a b' "$out"

# --map-path: a named option whose value is a host DIRECTORY.
#
# The working directory always crossed the boundary translated. An argument did
# not, so a tool that takes a directory saw a host path that does not exist
# inside the container. --map-path is the general fix, and it is opt-in: a shim
# asks for it by naming the option, and the router does the translation it
# already does for --cwd.

mkshim mapped --env verify-alt --map-path --repo
expect_contains 'O19 a mapped shim names the option in its route line' \
    '--map-path --repo' "$(cat "$SHIMS/mapped")"
expect_eq 'O20 a mapped shim is reproducible too' \
    "$(dbx new-shim mapped --env verify-alt --map-path --repo --print 2>/dev/null)" \
    "$(cat "$SHIMS/mapped")"

out=$(cd "$PROJECTS" && DEVBOX_DRY_RUN=1 runshim mapped --repo "$PROJECTS/a b" 2>&1)
expect_contains 'O21 a host path under the workspace is translated' \
    $'argv[2]=/workspace/a b' "$out"
out=$(cd "$PROJECTS" && DEVBOX_DRY_RUN=1 runshim mapped --repo /var/tmp/x 2>&1)
expect_contains 'O22 a host path outside the workspace goes through /run/host' \
    $'argv[2]=/run/host/var/tmp/x' "$out"
out=$(cd "$PROJECTS" && DEVBOX_DRY_RUN=1 runshim mapped --repo=/var/tmp/x 2>&1)
expect_contains 'O23 the --opt=VALUE form is translated too' \
    $'argv[1]=--repo=/run/host/var/tmp/x' "$out"
out=$(cd "$PROJECTS" && DEVBOX_DRY_RUN=1 runshim mapped --repo . 2>&1)
expect_contains 'O24 a relative value resolves against the working directory' \
    $'argv[2]=/workspace' "$out"
out=$(cd "$PROJECTS" && DEVBOX_DRY_RUN=1 runshim mapped --other /var/tmp/x 2>&1)
expect_contains 'O25 an option that was not named is left alone' \
    $'argv[2]=/var/tmp/x' "$out"
out=$(cd "$PROJECTS" && DEVBOX_DRY_RUN=1 runshim env --repo /var/tmp/x 2>&1)
expect_contains 'O26 a shim without --map-path translates nothing' \
    $'argv[2]=/var/tmp/x' "$out"

# A relative value cannot be passed through untouched. The two trees do not
# have the same shape at the workspace root, so a '..' that ESCAPES the root
# names a different directory on each side. These are the cases that a value
# left alone got wrong.
HOME_CANON=$(realpath -m -- "$HOME")
out=$(cd "$PROJECTS" && DEVBOX_DRY_RUN=1 runshim mapped --repo .. 2>&1)
expect_contains 'O29 a relative value that escapes the workspace is translated' \
    "argv[2]=/run/host$HOME_CANON" "$out"
# The sharp case: it escapes the workspace root and comes back in. Resolved on
# the far side it would name /projects/x, a directory that is not the one the
# user typed. Resolved on the host first it names the workspace path.
out=$(cd "$SCRATCH" && DEVBOX_DRY_RUN=1 runshim mapped --repo ../../projects/x 2>&1)
expect_contains 'O30 a relative value that escapes and returns names the host directory' \
    $'argv[2]=/workspace/x' "$out"

# The shell expands '--repo ~/x' but NOT '--repo=~/x'. Left alone, the far side
# expands the literal '~' against the ISOLATED container home.
out=$(cd "$PROJECTS" && DEVBOX_DRY_RUN=1 runshim mapped --repo='~/projects/x' 2>&1)
expect_contains 'O31 a tilde in the --opt=VALUE form expands against the host home' \
    $'argv[1]=--repo=/workspace/x' "$out"

# argv survives the mapping. It is carried as an array, so an argument that
# holds a newline stays one argument instead of becoming two.
out=$(cd "$PROJECTS" && DEVBOX_DRY_RUN=1 runshim mapped run $'a\nb' 2>&1)
argv_max=$(printf '%s\n' "$out" | sed -n 's/^argv\[\([0-9]*\)\]=.*/\1/p' | sort -n | tail -1)
expect_eq 'O32 an argument that holds a newline stays one argument' 2 "$argv_max"
# ... and a mapped value keeps a trailing newline, which $( ) would have eaten.
# A further argument follows it, because the $( ) that captures this output
# would strip the very newlines under test off the end of the last line.
out=$(cd "$PROJECTS" && DEVBOX_DRY_RUN=1 runshim mapped --repo "$PROJECTS/x"$'\n' end 2>&1)
expect_contains 'O33 a mapped value keeps a trailing newline' \
    $'argv[2]=/workspace/x\n\nargv[3]=end' "$out"

# --map-path is meaningful for a pinned shim only, and it wants an option name.
out=$(DEVBOX_SHIM_DIR=$SHIMS "$DEVBOX" new-shim unpinned --map-path --repo 2>&1); rc=$?
expect_rc 'O27 --map-path without --env is refused' 2 "$rc" "$out"
out=$(DEVBOX_SHIM_DIR=$SHIMS "$DEVBOX" new-shim bad --env verify-alt --map-path repo 2>&1)
rc=$?
expect_rc 'O28 --map-path wants a long option name' 2 "$rc" "$out"

# The recursion guard: a host shim must never run inside a container.
out=$(DEVBOX_ACTIVE_ENV=verify-alt runshim env 2>&1); rc=$?
expect_rc 'O11 a pinned shim refuses inside an environment' 8 "$rc" "$out"
expect_contains 'O12 and it says which environment' 'verify-alt' "$out"

# The exit status of the real command comes back to the host.
out=$(cd "$PROJECTS" && runshim env 2>&1 </dev/null); rc=$?
expect_rc 'O13 a pinned shim returns the exit status of a success' 0 "$rc" "$out"
out=$(cd "$PROJECTS" && runshim false 2>&1 </dev/null); rc=$?
expect_rc 'O14 a pinned shim returns the exit status of a failure' 1 "$rc" "$out"
mkshim definitely-not-a-real-command --env verify-alt
out=$(cd "$PROJECTS" && runshim definitely-not-a-real-command 2>&1 </dev/null); rc=$?
expect_rc 'O15 a missing command inside the environment still exits 127' 127 "$rc" "$out"

# The shim adds NOTHING to the environment of the delegated process. This is
# the check that keeps a host shim from becoming a place to put a credential.
# Both sides carry the same two test overrides, so the only difference that can
# appear is one the shim itself made.
shim_env=$(cd "$PROJECTS" && runshim env 2>/dev/null </dev/null | sort)
direct_env=$(cd "$PROJECTS" &&
    DEVBOX_CONFIG_HOME=$CFG DEVBOX_BIN=$DEVBOX "$DEVBOX" exec verify-alt \
        --cwd "$PROJECTS" -- env 2>/dev/null </dev/null | sort)
if [[ -z $shim_env || -z $direct_env ]]; then
    t_fail 'O16 the shim adds nothing to the delegated environment' \
        'one of the two environments could not be read'
else
    env_delta=$(diff <(printf '%s\n' "$direct_env") <(printf '%s\n' "$shim_env") |
                grep '^[<>]' | tr '\n' ' ')
    expect_eq 'O16 the shim adds nothing to the delegated environment' '' "$env_delta"
fi

# A terminal interrupt must reach the command inside the container, and the
# host must see the usual 130. A pty is what makes this representative: an
# interactive Ctrl-C goes to the foreground process group of the terminal, not
# to the host-side process id.
if command -v python3 >/dev/null 2>&1; then
    mkshim sleep --env verify-alt
    out=$(cd "$PROJECTS" && DEVBOX_CONFIG_HOME=$CFG DEVBOX_BIN=$DEVBOX \
          python3 - "$SHIMS/sleep" <<'PY'
import os, pty, signal, sys, time

shim = sys.argv[1]
pid, fd = pty.fork()
if pid == 0:
    os.execv("/bin/bash", ["bash", "-c", f'{shim} 25.7; echo "RC=$?"'])

time.sleep(4)                       # let the command reach the container
os.write(fd, b"\x03")               # Ctrl-C on the terminal

deadline, seen = time.time() + 15, ""
os.set_blocking(fd, False)
while time.time() < deadline and "RC=" not in seen:
    try:
        chunk = os.read(fd, 4096)
        if not chunk:
            break
        seen += chunk.decode(errors="replace")
    except BlockingIOError:
        time.sleep(0.2)
    except OSError:
        break
print(seen.replace("\r\n", " ").strip() or "(no output)")
try:
    os.kill(pid, signal.SIGKILL)
    os.waitpid(pid, 0)
except OSError:
    pass
PY
    )
    expect_contains 'O17 a terminal interrupt ends the delegated command (exit 130)' \
        'RC=130' "$out"
    left=$(dbx_cfg exec verify-alt -- bash -lc 'pgrep -c -f "sleep 25\.7" || true' \
           2>/dev/null </dev/null | tr -d '[:space:]')
    expect_eq 'O18 the interrupted command left nothing inside the environment' \
        0 "${left:-0}"
else
    t_skip 'O17 a terminal interrupt ends the delegated command' 'no python3'
    t_skip 'O18 the interrupted command left nothing inside the environment' 'no python3'
fi

# ------------------------------------------------------------------ summary --

printf '\n== summary ==\n'
printf 'passed  %d\nfailed  %d\nskipped %d\n' "$PASSED" "$FAILED" "$SKIPPED"
(( FAILED == 0 )) || exit 1
