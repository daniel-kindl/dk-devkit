#!/usr/bin/env python3
"""agentqueue - the trusted GitHub backlog coordinator.

    agentqueue drain --repo ~/projects/dkkb

It selects a runnable issue, drives bin/agentbox against a disposable clone,
pushes the validated branch, opens the pull request, waits for the checks and
merges. Then it looks again, because a merge can unblock the next issue.

The sandbox that runs model output holds no GitHub credential, no SSH key and
no Podman socket. This program holds all three kinds of authority, and it
hands none of them to a sandbox. See docs/agentqueue.md.
"""

import os
import sys

_HERE = os.path.dirname(os.path.abspath(os.path.realpath(__file__)))
_ROOT = os.path.dirname(_HERE)
sys.path.insert(0, os.path.join(_ROOT, "lib"))

from agentqueue.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(install_root=_ROOT))
