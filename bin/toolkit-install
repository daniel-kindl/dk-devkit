#!/usr/bin/env python3
"""Resolve and install a graph of reusable toolkit components.

Run it through install.sh at the top of the checkout. It discovers the
components in components/*/component.json, resolves the dependency and
capability closure of an explicit selection, shows the plan, converges the
components in deterministic order, and verifies only what it selected.

A selection comes from --components, from --profile, or from the interactive
picker. The picker runs only on a terminal, so an automated run reports a usage
error instead of waiting for an answer that never arrives.
"""

from __future__ import annotations

import argparse
import dataclasses
import json
import os
import platform
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Callable, Iterable, Mapping, Sequence

PROGRAM = "install.sh"
ROOT = Path(__file__).resolve().parent.parent
COMPONENT_DIR = ROOT / "components"
CAPABILITY_MANIFEST = ROOT / "manifests" / "capabilities.json"
PLATFORM_MANIFEST = ROOT / "manifests" / "platforms.json"

KINDS = ("tool", "runtime", "environment", "extras", "profile")
PROFILE = "profile"
ENVIRONMENT = "environment"
STATUSES = ("supported", "planned")
PLANNED = "planned"
# What an environment module must declare. A planned module declares the
# boundary only: the container name and the router markers it owns. A
# supported module also declares every file that installs it.
ENVIRONMENT_KEYS = ("container", "ini", "packages", "toolchain", "bootstrap",
                    "router", "inference", "home")
ENVIRONMENT_REQUIRED = ("container", "inference")
ENVIRONMENT_SUPPORTED_REQUIRED = ("ini", "packages", "toolchain", "bootstrap",
                                  "router", "home")
PROBE_KINDS = ("command", "executable", "uname", "not-container", "any", "platform")
SUPPORT = ("verified", "supported", "experimental", "unsupported")

# The public/local state boundary. state.public names tracked configuration
# inside this checkout. state.local names machine-local or private state, which
# always lives outside it. A local path therefore starts at the home directory
# or at an XDG variable, and never at one machine's home directory, so that the
# same manifest describes every machine. docs/components.md says why.
LOCAL_STATE_PREFIXES = ("~/", "$")
HOME_PREFIXES = ("/home/", "/var/home/", "/Users/", "/root/")

EXIT_OK = 0
EXIT_USAGE = 2
EXIT_RESOLVE = 3
EXIT_CAPABILITY = 4
EXIT_INSTALL = 5
EXIT_VERIFY = 6

INSTALL = "INSTALL"
READY = "ALREADY READY"
BLOCKED = "BLOCKED"
COMPOSITION = "COMPOSITION"


class ConfigError(ValueError):
    """A manifest is malformed, or names something that does not exist."""


class ResolveError(ValueError):
    """A selection cannot be resolved into an ordered component graph."""


# ------------------------------------------------------------------ model --


@dataclasses.dataclass(frozen=True)
class Capability:
    id: str
    summary: str
    probe: Mapping[str, object]


@dataclasses.dataclass(frozen=True)
class Adapter:
    """One platform. It says what the platform is, and how to get a capability.

    An adapter never installs anything. It translates a capability the toolkit
    asks for into the probe that finds it on this platform, and into the one
    step a human runs to obtain it. Platform-specific knowledge lives here and
    nowhere else.
    """

    id: str
    name: str
    family: str
    support: str
    note: str
    detect: Mapping[str, object]
    provides: Mapping[str, Mapping[str, object]]
    hints: Mapping[str, str]


@dataclasses.dataclass(frozen=True)
class Component:
    id: str
    name: str
    kind: str
    group: str
    summary: str
    status: str
    requires: tuple[str, ...]
    capabilities: tuple[str, ...]
    unattended: bool
    install: tuple[str, ...] | None
    doctor: tuple[str, ...] | None
    verify: tuple[str, ...] | None
    manual: tuple[str, ...]
    public_state: tuple[str, ...]
    local_state: tuple[str, ...]
    environment: Mapping[str, str] | None = None

    @property
    def planned(self) -> bool:
        """The module boundary exists; the installation does not exist yet."""
        return self.status == PLANNED


@dataclasses.dataclass(frozen=True)
class Step:
    component: Component
    status: str
    reason: str
    detail: str = ""


@dataclasses.dataclass(frozen=True)
class Plan:
    steps: tuple[Step, ...]
    hints: tuple[str, ...] = ()

    def of(self, status: str) -> tuple[Step, ...]:
        return tuple(step for step in self.steps if step.status == status)

    @property
    def blocked(self) -> tuple[Step, ...]:
        return self.of(BLOCKED)

    @property
    def manual(self) -> tuple[str, ...]:
        seen: list[str] = []
        for step in self.steps:
            if step.status == BLOCKED:
                continue
            for item in step.component.manual:
                if item not in seen:
                    seen.append(item)
        return tuple(seen)


# ----------------------------------------------------------------- loading --


def _string_list(value: object, where: str) -> tuple[str, ...]:
    if value is None:
        return ()
    if not isinstance(value, list) or not all(isinstance(item, str) for item in value):
        raise ConfigError(f"{where} must be an array of strings")
    return tuple(value)


def _names_a_home_directory(path: str) -> bool:
    """True when a path hard-codes one machine's home directory."""
    return any(path.startswith(prefix) for prefix in HOME_PREFIXES)


def _public_state(value: object, where: str) -> tuple[str, ...]:
    """Tracked configuration this component owns, relative to the checkout."""
    paths = _string_list(value, where)
    for path in paths:
        if not path.strip():
            raise ConfigError(f"{where} must not have an empty path")
        if path.startswith("/") or path.startswith("~") or path.startswith("$"):
            raise ConfigError(
                f"{where}: {path!r} must be relative to the checkout; "
                "public configuration is tracked here"
            )
        if path == ".." or path.startswith("../") or "/../" in path:
            raise ConfigError(f"{where}: {path!r} must not leave the checkout")
    if len(set(paths)) != len(paths):
        raise ConfigError(f"{where} must not repeat a path")
    return paths


def _local_state(value: object, where: str) -> tuple[str, ...]:
    """Machine-local or private state, which always lives outside the checkout."""
    paths = _string_list(value, where)
    for path in paths:
        if not path.strip():
            raise ConfigError(f"{where} must not have an empty path")
        if _names_a_home_directory(path):
            raise ConfigError(
                f"{where}: {path!r} names one machine's home directory; "
                "start the path at '~/' or at an XDG variable"
            )
        if not path.startswith(LOCAL_STATE_PREFIXES):
            raise ConfigError(
                f"{where}: {path!r} must start at '~/' or at an XDG variable; "
                "local state never lives inside the checkout"
            )
    if len(set(paths)) != len(paths):
        raise ConfigError(f"{where} must not repeat a path")
    return paths


def _command(value: object, where: str) -> tuple[str, ...] | None:
    if value is None:
        return None
    command = _string_list(value, where)
    if not command:
        raise ConfigError(f"{where} must not be an empty command")
    return command


def _environment(value: object, kind: str, status: str, where: str) -> Mapping[str, str] | None:
    """Validate the environment block of a development-environment module."""
    if value is None:
        if kind == ENVIRONMENT:
            raise ConfigError(f"{where}.environment is required for an environment")
        return None
    if kind != ENVIRONMENT:
        raise ConfigError(f"{where}.environment is only for kind {ENVIRONMENT}")
    if not isinstance(value, dict):
        raise ConfigError(f"{where}.environment must be an object")

    unknown = sorted(set(value) - set(ENVIRONMENT_KEYS))
    if unknown:
        raise ConfigError(f"{where}.environment has unknown keys: {', '.join(unknown)}")
    for key, item in value.items():
        if not isinstance(item, str) or not item.strip():
            raise ConfigError(f"{where}.environment.{key} must be a non-empty string")

    required = list(ENVIRONMENT_REQUIRED)
    if status != PLANNED:
        required += list(ENVIRONMENT_SUPPORTED_REQUIRED)
    missing = [key for key in required if key not in value]
    if missing:
        raise ConfigError(
            f"{where}.environment must declare: {', '.join(sorted(missing))}"
        )
    return dict(value)


def component_from(document: object, where: str) -> Component:
    if not isinstance(document, dict):
        raise ConfigError(f"{where} must be an object")
    if document.get("version") != 1:
        raise ConfigError(f"{where} version must be 1")

    identifier = document.get("id")
    if not isinstance(identifier, str) or not identifier.strip():
        raise ConfigError(f"{where}.id must be a non-empty string")
    if identifier != identifier.strip() or "/" in identifier:
        raise ConfigError(f"{where}.id must be a single trimmed path segment")

    kind = document.get("kind")
    if kind not in KINDS:
        raise ConfigError(f"{where}.kind must be one of {', '.join(KINDS)}")

    status = document.get("status", "supported")
    if status not in STATUSES:
        raise ConfigError(f"{where}.status must be one of {', '.join(STATUSES)}")
    if status == PLANNED and (document.get("install") or document.get("doctor")):
        raise ConfigError(f"{where} is planned, so it must declare no install and no doctor")

    for field in ("name", "group", "summary"):
        if not isinstance(document.get(field), str) or not document[field].strip():
            raise ConfigError(f"{where}.{field} must be a non-empty string")

    unattended = document.get("unattended")
    if not isinstance(unattended, bool):
        raise ConfigError(f"{where}.unattended must be true or false")

    requires = _string_list(document.get("requires"), f"{where}.requires")
    if identifier in requires:
        raise ConfigError(f"{where} must not require itself")
    if len(set(requires)) != len(requires):
        raise ConfigError(f"{where}.requires must not repeat a component")

    state = document.get("state", {})
    if not isinstance(state, dict):
        raise ConfigError(f"{where}.state must be an object")

    return Component(
        id=identifier,
        name=document["name"],
        kind=kind,
        group=document["group"],
        summary=document["summary"],
        status=status,
        requires=requires,
        capabilities=_string_list(document.get("capabilities"), f"{where}.capabilities"),
        unattended=unattended,
        install=_command(document.get("install"), f"{where}.install"),
        doctor=_command(document.get("doctor"), f"{where}.doctor"),
        verify=_command(document.get("verify"), f"{where}.verify"),
        manual=_string_list(document.get("manual"), f"{where}.manual"),
        public_state=_public_state(state.get("public"), f"{where}.state.public"),
        local_state=_local_state(state.get("local"), f"{where}.state.local"),
        environment=_environment(document.get("environment"), kind, status, where),
    )


def load_components(directory: Path) -> dict[str, Component]:
    components: dict[str, Component] = {}
    for manifest in sorted(directory.glob("*/component.json")):
        where = f"{manifest.parent.name}/component.json"
        try:
            document = json.loads(manifest.read_text(encoding="utf-8"))
        except OSError as exc:
            raise ConfigError(f"cannot read {where}: {exc}") from exc
        except json.JSONDecodeError as exc:
            raise ConfigError(f"invalid JSON in {where}: {exc}") from exc
        component = component_from(document, where)
        if component.id != manifest.parent.name:
            raise ConfigError(
                f"{where} declares id {component.id!r} but lives in {manifest.parent.name!r}"
            )
        if component.id in components:
            raise ConfigError(f"duplicate component id: {component.id}")
        components[component.id] = component

    for component in components.values():
        for dependency in component.requires:
            if dependency not in components:
                raise ConfigError(
                    f"{component.id} requires {dependency!r}, which is not a component"
                )
    return components


def load_capabilities(path: Path) -> dict[str, Capability]:
    try:
        document = json.loads(path.read_text(encoding="utf-8"))
    except OSError as exc:
        raise ConfigError(f"cannot read {path}: {exc}") from exc
    except json.JSONDecodeError as exc:
        raise ConfigError(f"invalid JSON in {path}: {exc}") from exc
    if not isinstance(document, dict) or document.get("version") != 1:
        raise ConfigError("capability manifest version must be 1")
    raw = document.get("capabilities")
    if not isinstance(raw, list):
        raise ConfigError("capability manifest capabilities must be an array")

    capabilities: dict[str, Capability] = {}
    for index, value in enumerate(raw):
        where = f"capabilities[{index}]"
        if not isinstance(value, dict):
            raise ConfigError(f"{where} must be an object")
        identifier = value.get("id")
        summary = value.get("summary")
        if not isinstance(identifier, str) or not identifier.strip():
            raise ConfigError(f"{where}.id must be a non-empty string")
        if not isinstance(summary, str) or not summary.strip():
            raise ConfigError(f"{where}.summary must be a non-empty string")
        probe = value.get("probe")
        _check_probe(probe, f"{where}.probe")
        if identifier in capabilities:
            raise ConfigError(f"duplicate capability id: {identifier}")
        capabilities[identifier] = Capability(identifier, summary, probe)
    return capabilities


def _check_probe(probe: object, where: str, allow_platform: bool = True) -> None:
    if not isinstance(probe, dict):
        raise ConfigError(f"{where} must be an object")
    kind = probe.get("kind")
    if kind not in PROBE_KINDS:
        raise ConfigError(f"{where}.kind must be one of {', '.join(PROBE_KINDS)}")
    if kind == "platform":
        # "platform" says that only an adapter can supply this capability. An
        # adapter must therefore answer with a real probe, and a "platform"
        # probe inside "any" would ask a question no probe can answer.
        if not allow_platform:
            raise ConfigError(f"{where}.kind must not be platform here")
        return
    if kind == "not-container":
        return
    value = probe.get("value")
    if kind == "any":
        if not isinstance(value, list) or not value:
            raise ConfigError(f"{where}.value must be a non-empty array of probes")
        for index, nested in enumerate(value):
            _check_probe(nested, f"{where}.value[{index}]", allow_platform=False)
        return
    if not isinstance(value, str) or not value:
        raise ConfigError(f"{where}.value must be a non-empty string")


DETECT_KINDS = ("os-release", "uname")


def load_adapters(path: Path) -> tuple[Adapter, ...]:
    """Load the platform adapters in manifest order. The first match wins."""
    try:
        document = json.loads(path.read_text(encoding="utf-8"))
    except OSError as exc:
        raise ConfigError(f"cannot read {path}: {exc}") from exc
    except json.JSONDecodeError as exc:
        raise ConfigError(f"invalid JSON in {path}: {exc}") from exc
    if not isinstance(document, dict) or document.get("version") != 1:
        raise ConfigError("platform manifest version must be 1")
    raw = document.get("platforms")
    if not isinstance(raw, list) or not raw:
        raise ConfigError("platform manifest platforms must be a non-empty array")

    adapters: list[Adapter] = []
    seen: set[str] = set()
    for index, value in enumerate(raw):
        where = f"platforms[{index}]"
        if not isinstance(value, dict):
            raise ConfigError(f"{where} must be an object")
        for field in ("id", "name", "family", "note"):
            if not isinstance(value.get(field), str) or not value[field].strip():
                raise ConfigError(f"{where}.{field} must be a non-empty string")
        support = value.get("support")
        if support not in SUPPORT:
            raise ConfigError(f"{where}.support must be one of {', '.join(SUPPORT)}")
        if value["id"] in seen:
            raise ConfigError(f"duplicate platform id: {value['id']}")
        seen.add(value["id"])

        _check_detect(value.get("detect"), f"{where}.detect")

        provides = value.get("provides", {})
        if not isinstance(provides, dict):
            raise ConfigError(f"{where}.provides must be an object")
        for capability, probe in provides.items():
            _check_probe(probe, f"{where}.provides.{capability}", allow_platform=False)

        hints = value.get("hints", {})
        if not isinstance(hints, dict) or not all(
            isinstance(text, str) and text.strip() for text in hints.values()
        ):
            raise ConfigError(f"{where}.hints must map a capability to one sentence")

        adapters.append(
            Adapter(
                id=value["id"],
                name=value["name"],
                family=value["family"],
                support=support,
                note=value["note"],
                detect=value["detect"],
                provides=provides,
                hints=hints,
            )
        )
    return tuple(adapters)


def _check_detect(detect: object, where: str) -> None:
    if not isinstance(detect, dict):
        raise ConfigError(f"{where} must be an object")
    kind = detect.get("kind")
    if kind not in DETECT_KINDS:
        raise ConfigError(f"{where}.kind must be one of {', '.join(DETECT_KINDS)}")
    if kind == "uname":
        if not isinstance(detect.get("value"), str) or not detect["value"]:
            raise ConfigError(f"{where}.value must be a non-empty string")
        return
    ids = _string_list(detect.get("ids"), f"{where}.ids")
    like = _string_list(detect.get("id_like"), f"{where}.id_like")
    if not ids and not like:
        raise ConfigError(f"{where} must name at least one os-release id")


def check_adapter_references(
    adapters: Sequence[Adapter], capabilities: Mapping[str, Capability]
) -> None:
    """An adapter may only answer for a capability the toolkit declares."""
    for adapter in adapters:
        for capability in tuple(adapter.provides) + tuple(adapter.hints):
            if capability not in capabilities:
                raise ConfigError(
                    f"platform {adapter.id} names capability {capability!r}, "
                    "which manifests/capabilities.json does not define"
                )


def check_platform_capabilities(
    capabilities: Mapping[str, Capability], adapters: Sequence[Adapter]
) -> None:
    """A platform-only capability is useless when no adapter can supply it."""
    for identifier, capability in capabilities.items():
        if capability.probe.get("kind") != "platform":
            continue
        if not any(identifier in adapter.provides for adapter in adapters):
            raise ConfigError(
                f"capability {identifier!r} is platform-only, "
                "but no platform in manifests/platforms.json provides it"
            )


def check_capability_references(
    components: Mapping[str, Component], capabilities: Mapping[str, Capability]
) -> None:
    for component in components.values():
        for capability in component.capabilities:
            if capability not in capabilities:
                raise ConfigError(
                    f"{component.id} needs capability {capability!r}, "
                    "which manifests/capabilities.json does not define"
                )


# ------------------------------------------------------------- detection --


@dataclasses.dataclass(frozen=True)
class Host:
    """Everything the probes are allowed to look at, so tests can supply it."""

    which: Callable[[str], str | None]
    is_executable: Callable[[str], bool]
    system: str
    machine: str = ""
    in_container: bool = False
    os_release: Mapping[str, str] = dataclasses.field(default_factory=dict)
    wsl: bool = False

    @classmethod
    def detect(cls) -> "Host":
        return cls(
            which=lambda name: shutil.which(name),
            is_executable=lambda path: os.access(path, os.X_OK),
            system=platform.system(),
            machine=platform.machine(),
            in_container=Path("/run/.containerenv").exists() or Path("/.dockerenv").exists(),
            os_release=read_os_release(),
            wsl="microsoft" in _read_text(Path("/proc/version")).lower(),
        )


def _read_text(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""


def read_os_release(path: Path = Path("/etc/os-release")) -> dict[str, str]:
    """Parse the os-release fields the adapters match on.

    A machine without the file is not an error. It is a platform no adapter
    recognises, and the report says so.
    """
    fields: dict[str, str] = {}
    for line in _read_text(path).splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        fields[key.strip()] = value.strip().strip('"').strip("'")
    return fields


def probe_matches(probe: Mapping[str, object], host: Host) -> bool:
    kind = probe["kind"]
    if kind == "command":
        return host.which(str(probe["value"])) is not None
    if kind == "executable":
        return host.is_executable(str(probe["value"]))
    if kind == "uname":
        return host.system == probe["value"]
    if kind == "not-container":
        return not host.in_container
    if kind == "any":
        return any(probe_matches(nested, host) for nested in probe["value"])  # type: ignore[union-attr]
    if kind == "platform":
        # Only an adapter answers this one, and detect_capabilities has already
        # replaced it with the adapter probe when the adapter provides it.
        return False
    raise ConfigError(f"unknown probe kind: {kind!r}")


def adapter_matches(detect: Mapping[str, object], host: Host) -> bool:
    kind = detect["kind"]
    if kind == "uname":
        return host.system == detect["value"]
    if kind == "os-release":
        identifier = host.os_release.get("ID", "")
        if identifier and identifier in tuple(detect.get("ids", ())):  # type: ignore[arg-type]
            return True
        like = set(host.os_release.get("ID_LIKE", "").split())
        return bool(like & set(detect.get("id_like", ())))  # type: ignore[arg-type]
    raise ConfigError(f"unknown platform detect kind: {kind!r}")


def detect_platform(adapters: Sequence[Adapter], host: Host) -> Adapter | None:
    """The first adapter that matches. Manifest order decides a tie.

    A derivative is listed before the family it derives from, so Bazzite wins
    over Fedora even though Bazzite also reports ID_LIKE=fedora.
    """
    for adapter in adapters:
        if adapter_matches(adapter.detect, host):
            return adapter
    return None


def detect_capabilities(
    capabilities: Mapping[str, Capability], host: Host, adapter: Adapter | None = None
) -> frozenset[str]:
    """Detect what this machine has. The adapter answers first.

    A capability the adapter provides is probed the platform's way. Everything
    else is probed the generic way. A platform-only capability that the adapter
    does not provide is absent, and the plan reports it as a missing capability
    rather than failing during installation.
    """
    provided = adapter.provides if adapter else {}
    return frozenset(
        identifier
        for identifier, capability in capabilities.items()
        if probe_matches(provided.get(identifier, capability.probe), host)
    )


def capability_hint(adapter: Adapter | None, capability: str) -> str:
    """The one step that obtains a capability on this platform, or nothing."""
    if adapter is None:
        return ""
    return adapter.hints.get(capability, "")


# -------------------------------------------------------------- resolution --


def closure(
    components: Mapping[str, Component], selection: Sequence[str]
) -> tuple[dict[str, str], tuple[str, ...]]:
    """Return the reason for every component, and a deterministic install order.

    The reason says why a component is in the plan: it was selected, or another
    component declared it. Ordering is dependencies first, and ties break on the
    identifier, so the same selection always produces the same order.
    """
    unknown = [name for name in selection if name not in components]
    if unknown:
        raise ResolveError(
            "unknown component: " + ", ".join(sorted(unknown))
        )

    reasons: dict[str, str] = {}
    pending = list(dict.fromkeys(selection))
    for name in pending:
        reasons[name] = "selected"
    while pending:
        current = pending.pop(0)
        for dependency in components[current].requires:
            if dependency not in reasons:
                reasons[dependency] = f"required by {current}"
                pending.append(dependency)

    planned = sorted(name for name in reasons if components[name].planned)
    if planned:
        # A planned module is a boundary, not an installation. Refusing here
        # covers a dependency exactly the way it covers a selection.
        raise ResolveError(
            "planned, so it cannot be installed yet: " + ", ".join(planned)
        )

    order = _topological_order(components, reasons.keys())
    return reasons, order


def state_selection(
    components: Mapping[str, Component], selection: Sequence[str]
) -> tuple[Component, ...]:
    """Every component a selection reaches, for reporting only.

    It walks the same 'requires' edges as closure(), but it reports a planned
    module instead of refusing it. A planned module still declares where its
    configuration and its state belong, and that boundary is what a reader asks
    '--state' about.
    """
    unknown = [name for name in selection if name not in components]
    if unknown:
        raise ResolveError("unknown component: " + ", ".join(sorted(unknown)))
    reached = list(dict.fromkeys(selection))
    for name in reached:
        for dependency in components[name].requires:
            if dependency not in reached:
                reached.append(dependency)
    return tuple(components[name] for name in reached)


def _topological_order(
    components: Mapping[str, Component], names: Iterable[str]
) -> tuple[str, ...]:
    included = set(names)
    remaining = {
        name: {dep for dep in components[name].requires if dep in included}
        for name in included
    }
    order: list[str] = []
    while remaining:
        ready = sorted(name for name, deps in remaining.items() if not deps)
        if not ready:
            raise ResolveError(
                "dependency cycle between components: " + ", ".join(sorted(remaining))
            )
        for name in ready:
            order.append(name)
            del remaining[name]
        for deps in remaining.values():
            deps.difference_update(ready)
    return tuple(order)


# -------------------------------------------------------------- planning --


def _doctor_says_ready(component: Component, root: Path) -> bool:
    if component.doctor is None:
        return False
    return _run(component.doctor, root, capture=True).returncode == 0


def build_plan(
    components: Mapping[str, Component],
    reasons: Mapping[str, str],
    order: Sequence[str],
    present: frozenset[str],
    root: Path,
    force: bool = False,
    doctor: Callable[[Component, Path], bool] | None = None,
    adapter: Adapter | None = None,
) -> Plan:
    ask = doctor or _doctor_says_ready
    steps: list[Step] = []
    blocked: set[str] = set()
    hints: list[str] = []

    for name in order:
        component = components[name]
        missing = tuple(
            capability for capability in component.capabilities if capability not in present
        )
        upstream = tuple(dep for dep in component.requires if dep in blocked)
        if missing:
            blocked.add(name)
            steps.append(Step(component, BLOCKED, reasons[name],
                              "missing capability: " + ", ".join(missing)))
            for capability in missing:
                hint = capability_hint(adapter, capability)
                if hint and hint not in hints:
                    hints.append(hint)
            continue
        if upstream:
            blocked.add(name)
            steps.append(Step(component, BLOCKED, reasons[name],
                              "blocked by: " + ", ".join(upstream)))
            continue
        if component.install is None and component.doctor is None:
            steps.append(Step(component, COMPOSITION, reasons[name],
                              "nothing to install; it composes other components"))
            continue
        if not force and ask(component, root):
            steps.append(Step(component, READY, reasons[name]))
            continue
        if component.install is None:
            blocked.add(name)
            steps.append(Step(component, BLOCKED, reasons[name],
                              "no installer; the platform must provide it"))
            continue
        steps.append(Step(component, INSTALL, reasons[name]))
    return Plan(tuple(steps), tuple(hints))


def render_plan(plan: Plan) -> str:
    lines: list[str] = []
    width = max((len(step.component.id) for step in plan.steps), default=0)

    def block(title: str, steps: Sequence[Step]) -> None:
        if not steps:
            return
        lines.append(title)
        for step in steps:
            # Every component says why it is in the plan, so that a dependency
            # is never a surprise.
            note = step.detail
            if step.reason != "selected":
                note = f"{note} ({step.reason})" if note else step.reason
            lines.append(f"  {step.component.id.ljust(width)}  {note}".rstrip())

    block(INSTALL, plan.of(INSTALL))
    block(READY, plan.of(READY))
    block(COMPOSITION, plan.of(COMPOSITION))
    block(BLOCKED, plan.blocked)
    if plan.hints:
        # A blocked component says what is missing. The platform adapter says
        # how to get it here, so the message is one step, not a search.
        lines.append("ON THIS PLATFORM")
        for hint in plan.hints:
            lines.append(f"  {hint}")
    if plan.manual:
        lines.append("MANUAL ACTION")
        for item in plan.manual:
            lines.append(f"  {item}")
    return "\n".join(lines)


def render_catalogue(
    components: Mapping[str, Component], present: frozenset[str]
) -> str:
    lines: list[str] = []
    groups: dict[str, list[Component]] = {}
    for component in components.values():
        groups.setdefault(component.group, []).append(component)
    width = max((len(name) for name in components), default=0)
    for group in sorted(groups):
        lines.append(group)
        for component in sorted(groups[group], key=lambda item: item.id):
            missing = [c for c in component.capabilities if c not in present]
            if component.planned:
                mark = "~ "
            elif missing:
                mark = "! "
            else:
                mark = "  "
            lines.append(f"  {mark}{component.id.ljust(width)}  {component.summary}")
            if component.requires:
                lines.append(f"    {' ' * width}  requires: {', '.join(component.requires)}")
            if component.planned:
                lines.append(f"    {' ' * width}  planned: no installation yet")
            elif missing:
                lines.append(f"    {' ' * width}  missing capability: {', '.join(missing)}")
        lines.append("")
    lines.append("  ! the machine is missing a capability this component needs")
    lines.append("  ~ the module exists; the installation is future work")
    return "\n".join(lines).rstrip()


def render_state(components: Sequence[Component]) -> str:
    """Report the public/local state boundary of the components it is given.

    It reads the manifests and nothing else, so it never touches the machine.
    A component that owns no state at all still appears, because 'nothing' is
    the answer a reader needs when they look for its private state.
    """
    lines: list[str] = []
    for component in sorted(components, key=lambda item: (item.group, item.id)):
        lines.append(f"{component.id}  ({component.kind})")
        for path in component.public_state:
            lines.append(f"  public  {path}")
        for path in component.local_state:
            lines.append(f"  local   {path}")
        if not component.public_state and not component.local_state:
            lines.append("  none    this component owns no configuration and no state")
        for item in component.manual:
            lines.append(f"  manual  {item}")
        lines.append("")
    lines.append("  public  tracked in this checkout, and reusable on any machine")
    lines.append("  local   machine-local or private, and never tracked here")
    lines.append("  manual  a step a human completes, such as authentication")
    return "\n".join(lines)


def environment_modules(
    components: Mapping[str, Component], status: str | None = None
) -> tuple[Component, ...]:
    """Every development-environment module, in one deterministic order."""
    return tuple(
        sorted(
            (
                item
                for item in components.values()
                if item.kind == ENVIRONMENT and (status is None or item.status == status)
            ),
            key=lambda item: item.id,
        )
    )


def render_environments(components: Mapping[str, Component]) -> str:
    """The environment modules as TSV, for the shell half of the toolkit.

    The bootstrap and the router installation read this instead of holding a
    list of environment names, so that adding an environment stays one module.
    An absent field is a single "-", because a shell "read" collapses an empty
    tab-separated column.
    """
    lines = ["\t".join(("id", "status") + ENVIRONMENT_KEYS)]
    for component in environment_modules(components):
        block = component.environment or {}
        lines.append(
            "\t".join((component.id, component.status)
                      + tuple(block.get(key, "-") for key in ENVIRONMENT_KEYS))
        )
    return "\n".join(lines)


def render_report(
    components: Mapping[str, Component],
    capabilities: Mapping[str, Capability],
    host: Host,
    adapter: Adapter | None,
    present: frozenset[str],
) -> str:
    """The platform and capability report, for a machine that must be diagnosed.

    It changes nothing. It says what this machine is, what the toolkit found,
    and which component the machine cannot install yet.
    """
    lines = ["Platform"]
    lines.append(f"  {host.system} {host.machine}".rstrip())
    if adapter is None:
        lines.append("  unknown platform; no adapter matches this machine")
        lines.append("  the generic capability probes still apply")
    else:
        lines.append(f"  {adapter.name} ({adapter.family} family), {adapter.support}")
        lines.append(f"  {adapter.note}")
    if host.wsl:
        lines.append("  running under WSL; WSL2 is not a verified platform")
    if host.in_container:
        lines.append("  running inside a container, not on the host")

    width = max((len(name) for name in capabilities), default=0)
    lines.append("")
    lines.append("Capabilities")
    for identifier, capability in sorted(capabilities.items()):
        mark = "ok" if identifier in present else "--"
        lines.append(f"  {mark}  {identifier.ljust(width)}  {capability.summary}")
        if identifier in present:
            continue
        hint = capability_hint(adapter, identifier)
        if hint:
            lines.append(f"      {' ' * width}  {hint}")

    width = max((len(name) for name in components), default=0)
    lines.append("")
    lines.append("Components")
    for identifier, reason in sorted(unsupported(components, present).items()):
        mark = "--" if reason else "ok"
        lines.append(f"  {mark}  {identifier.ljust(width)}  {reason}".rstrip())
    return "\n".join(lines)


def unsupported(
    components: Mapping[str, Component], present: frozenset[str]
) -> dict[str, str]:
    """Say, for every component, why this machine cannot install it yet.

    A component is unsupported when the machine lacks a capability it declares,
    or when something it requires is unsupported. An empty reason means the
    machine can install it. One unsupported component never hides another.
    """
    reasons: dict[str, str] = {}
    for identifier in _topological_order(components, components.keys()):
        component = components[identifier]
        if component.planned:
            reasons[identifier] = "planned: no installation yet"
            continue
        missing = [c for c in component.capabilities if c not in present]
        if missing:
            reasons[identifier] = "missing capability: " + ", ".join(missing)
            continue
        upstream = [dep for dep in component.requires if reasons.get(dep)]
        reasons[identifier] = (
            "blocked by: " + ", ".join(upstream) if upstream else ""
        )
    return reasons


# --------------------------------------------------------------- profiles --


def profile_ids(components: Mapping[str, Component]) -> tuple[str, ...]:
    """Every profile identifier, in one deterministic order."""
    return tuple(
        sorted(name for name, item in components.items() if item.kind == PROFILE)
    )


def resolve_profiles(
    components: Mapping[str, Component], names: Sequence[str]
) -> tuple[str, ...]:
    """Accept profile identifiers only, so --profile cannot select a tool."""
    known = profile_ids(components)
    for name in names:
        if name not in components:
            raise ResolveError(
                f"unknown profile: {name}; the profiles are: {', '.join(known)}"
            )
        if components[name].kind != PROFILE:
            raise ResolveError(
                f"{name} is a component, not a profile; "
                f"select it with --components {name}"
            )
    return tuple(dict.fromkeys(names))


# ----------------------------------------------------------------- picker --

TOGGLE = "toggle"
CONFIRM = "confirm"
CANCEL = "cancel"
HELP = "help"

PICKER_HELP = """\
  <number>   toggle that component; several numbers on one line are allowed
  <id>       toggle a component or a profile by name
  none       clear the selection
  Enter      resolve the selection and show the plan
  q          cancel and change nothing"""


SUMMARY_WIDTH = 64


def picker_entries(components: Mapping[str, Component]) -> tuple[Component, ...]:
    """The picker order: by group, then by identifier. A number never moves.

    A planned component is left out. The picker offers what this toolkit can
    install; '--list' is where a planned module is reported.
    """
    return tuple(
        sorted(
            (item for item in components.values() if not item.planned),
            key=lambda item: (item.group, item.id),
        )
    )


def _short(text: str, width: int = SUMMARY_WIDTH) -> str:
    """Keep one picker line on one terminal line."""
    if len(text) <= width:
        return text
    return text[: width - 3].rstrip() + "..."


def render_picker(
    entries: Sequence[Component], selection: Sequence[str], present: frozenset[str]
) -> str:
    lines: list[str] = []
    width = max((len(item.id) for item in entries), default=0)
    group = ""
    for number, component in enumerate(entries, start=1):
        if component.group != group:
            group = component.group
            lines.append(group)
        mark = "x" if component.id in selection else " "
        missing = [c for c in component.capabilities if c not in present]
        note = "!" if missing else " "
        lines.append(
            f"  {number:>2} [{mark}] {note} {component.id.ljust(width)}  "
            f"{_short(component.summary)}"
        )
    lines.append("")
    lines.append("  ! the machine is missing a capability this component needs")
    return "\n".join(lines)


def picker_command(
    entries: Sequence[Component], selection: Sequence[str], line: str
) -> tuple[str, tuple[str, ...], str]:
    """Apply one picker line. Return the action, the selection and a message.

    A line is applied completely or not at all, so an unknown word never
    changes half of the selection.
    """
    text = line.strip()
    current = tuple(selection)
    if not text:
        if not current:
            return TOGGLE, current, "nothing is selected; type a number, or q to cancel"
        return CONFIRM, current, ""
    lowered = text.lower()
    if lowered in ("q", "quit"):
        return CANCEL, current, ""
    if lowered in ("?", "h", "help"):
        return HELP, current, ""
    if lowered == "none":
        return TOGGLE, (), ""

    known = {component.id for component in entries}
    wanted: list[str] = []
    for word in text.replace(",", " ").split():
        if word.isdigit():
            number = int(word)
            if not 1 <= number <= len(entries):
                return TOGGLE, current, f"no such number: {word}"
            wanted.append(entries[number - 1].id)
        elif word in known:
            wanted.append(word)
        else:
            return TOGGLE, current, f"unknown choice: {word}"

    chosen = set(current)
    for name in wanted:
        chosen.symmetric_difference_update({name})
    return TOGGLE, tuple(sorted(chosen)), ""


def run_picker(
    entries: Sequence[Component],
    present: frozenset[str],
    read: Callable[[str], str] = input,
    write: Callable[[str], None] = print,
) -> tuple[str, ...] | None:
    """Ask a human what to install. Return None when the human cancels."""
    selection: tuple[str, ...] = ()
    message = ""
    while True:
        write("")
        write(render_picker(entries, selection, present))
        write("")
        write("Select what to install. '?' explains the choices.")
        if message:
            write(message)
        try:
            line = read("select> ")
        except (EOFError, KeyboardInterrupt):
            write("")
            return None
        action, selection, message = picker_command(entries, selection, line)
        if action == CANCEL:
            return None
        if action == CONFIRM:
            return selection
        if action == HELP:
            write("")
            write(PICKER_HELP)
            message = ""


def confirm(question: str, read: Callable[[str], str] = input) -> bool:
    """Ask before mutation. Anything but an explicit yes means no."""
    try:
        answer = read(f"{question} [y/N] ")
    except (EOFError, KeyboardInterrupt):
        return False
    return answer.strip().lower() in ("y", "yes")


# -------------------------------------------------------------- execution --


def _run(command: Sequence[str], root: Path, capture: bool = False) -> subprocess.CompletedProcess:
    resolved = list(command)
    candidate = root / resolved[0]
    if candidate.exists():
        resolved[0] = str(candidate)
    return subprocess.run(
        resolved,
        cwd=root,
        check=False,
        capture_output=capture,
        text=True,
    )


def execute(plan: Plan, root: Path, runner: Callable[..., subprocess.CompletedProcess] | None = None) -> Step | None:
    """Install every INSTALL step in order. Return the step that failed."""
    call = runner or _run
    for step in plan.of(INSTALL):
        assert step.component.install is not None
        print(f"\n==> installing {step.component.id}", flush=True)
        result = call(step.component.install, root)
        if result.returncode != 0:
            return dataclasses.replace(step, detail=f"exit {result.returncode}")
    return None


def verify(plan: Plan, root: Path, runner: Callable[..., subprocess.CompletedProcess] | None = None) -> tuple[Step, ...]:
    """Verify every selected component that is not blocked."""
    call = runner or _run
    failed: list[Step] = []
    for step in plan.steps:
        if step.status == BLOCKED or step.component.verify is None:
            continue
        print(f"\n==> verifying {step.component.id}", flush=True)
        result = call(step.component.verify, root)
        if result.returncode != 0:
            failed.append(dataclasses.replace(step, detail=f"exit {result.returncode}"))
    return tuple(failed)


# ------------------------------------------------------------------- CLI --


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=PROGRAM,
        description="Install reusable toolkit components and only what they declare.",
    )
    parser.add_argument("--components", default="",
                        help="comma-separated component identifiers to install")
    parser.add_argument("--profile", default="",
                        help="comma-separated profiles; each expands to a component set")
    parser.add_argument("--list", action="store_true",
                        help="list the components and change nothing")
    parser.add_argument("--environments", action="store_true",
                        help="list the development environment modules as TSV")
    parser.add_argument("--doctor", action="store_true",
                        help="report the platform and its capabilities, and change nothing")
    parser.add_argument("--state", action="store_true",
                        help="report the public/local state boundary, and change nothing")
    parser.add_argument("--hint", default="",
                        help="print how to obtain one capability on this platform")
    parser.add_argument("--dry-run", action="store_true",
                        help="show the resolved plan and change nothing")
    parser.add_argument("--force", action="store_true",
                        help="install a component again even when it is already ready")
    parser.add_argument("--no-verify", action="store_true",
                        help="install without verifying the selected components")
    return parser


def _selection(value: str) -> list[str]:
    return [item.strip() for item in value.split(",") if item.strip()]


def _on_a_terminal() -> bool:
    return sys.stdin.isatty() and sys.stdout.isatty()


def main(argv: Sequence[str] | None = None) -> int:
    args = build_parser().parse_args(argv)

    try:
        components = load_components(COMPONENT_DIR)
        capabilities = load_capabilities(CAPABILITY_MANIFEST)
        adapters = load_adapters(PLATFORM_MANIFEST)
        check_capability_references(components, capabilities)
        check_adapter_references(adapters, capabilities)
        check_platform_capabilities(capabilities, adapters)
    except ConfigError as exc:
        print(f"{PROGRAM}: {exc}", file=sys.stderr)
        return EXIT_USAGE

    host = Host.detect()
    adapter = detect_platform(adapters, host)
    present = detect_capabilities(capabilities, host, adapter)

    if args.hint:
        # The shell half of the toolkit asks the same question here, so that
        # one platform fact never has two copies.
        if args.hint not in capabilities:
            print(f"{PROGRAM}: unknown capability: {args.hint}", file=sys.stderr)
            return EXIT_USAGE
        hint = capability_hint(adapter, args.hint)
        if not hint:
            return EXIT_CAPABILITY
        print(hint)
        return EXIT_OK

    if args.environments:
        print(render_environments(components))
        return EXIT_OK

    if args.doctor:
        print(render_report(components, capabilities, host, adapter, present))
        return EXIT_OK

    if args.list:
        print(render_catalogue(components, present))
        return EXIT_OK

    if args.state:
        # A selection narrows the report. Without one it covers every
        # component, so a clean clone can read the whole boundary at once.
        try:
            wanted = list(resolve_profiles(components, _selection(args.profile)))
            wanted += _selection(args.components)
            chosen = (state_selection(components, wanted) if wanted
                      else tuple(components.values()))
        except ResolveError as exc:
            print(f"{PROGRAM}: {exc}", file=sys.stderr)
            return EXIT_RESOLVE
        print(render_state(chosen))
        return EXIT_OK

    try:
        selection = list(resolve_profiles(components, _selection(args.profile)))
    except ResolveError as exc:
        print(f"{PROGRAM}: {exc}", file=sys.stderr)
        return EXIT_RESOLVE
    selection += _selection(args.components)

    # The picker is the only part that asks a question, and it asks it only on
    # a terminal. An automated run says what it needs and stops.
    picked = False
    if not selection:
        if not _on_a_terminal():
            print(f"{PROGRAM}: name what to install, for example "
                  f"--components devbox,web-dev or --profile developer",
                  file=sys.stderr)
            print(f"{PROGRAM}: the profiles are: "
                  f"{', '.join(profile_ids(components))}", file=sys.stderr)
            print(f"{PROGRAM}: '{PROGRAM} --list' shows every component",
                  file=sys.stderr)
            return EXIT_USAGE
        chosen = run_picker(picker_entries(components), present)
        if chosen is None:
            print(f"{PROGRAM}: cancelled; nothing was installed")
            return EXIT_OK
        selection = list(chosen)
        picked = True

    try:
        reasons, order = closure(components, selection)
    except ResolveError as exc:
        print(f"{PROGRAM}: {exc}", file=sys.stderr)
        return EXIT_RESOLVE

    plan = build_plan(components, reasons, order, present, ROOT,
                      force=args.force, adapter=adapter)
    print(f"{PROGRAM}: {ROOT}")
    print(render_plan(plan))

    if args.dry_run:
        return EXIT_OK
    if plan.blocked:
        names = ", ".join(step.component.id for step in plan.blocked)
        print(f"{PROGRAM}: refusing to install; blocked components: {names}", file=sys.stderr)
        return EXIT_CAPABILITY
    if picked and not confirm("\nInstall this plan?"):
        print(f"{PROGRAM}: cancelled; nothing was installed")
        return EXIT_OK

    failure = execute(plan, ROOT)
    if failure is not None:
        print(f"{PROGRAM}: component {failure.component.id} failed ({failure.detail})",
              file=sys.stderr)
        return EXIT_INSTALL

    if not args.no_verify:
        failed = verify(plan, ROOT)
        if failed:
            names = ", ".join(step.component.id for step in failed)
            print(f"{PROGRAM}: verification failed: {names}", file=sys.stderr)
            return EXIT_VERIFY

    print(f"\n{PROGRAM}: {len(plan.of(INSTALL))} installed, "
          f"{len(plan.of(READY))} already ready")
    if plan.manual:
        print("\nManual steps that remain:")
        for item in plan.manual:
            print(f"  - {item}")
    return EXIT_OK


if __name__ == "__main__":
    raise SystemExit(main())
