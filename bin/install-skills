#!/usr/bin/env bash
#
# install-skills - resolve, install and update third-party agent skills.
#
#   install-skills                     install the default skill profile
#   install-skills --profile NAME      install another tracked profile
#   install-skills --resolve           print the resolved profile as TSV
#   install-skills --list-profiles     list tracked profiles
#   install-skills tdd humanizer       install only these resolved skills
#   install-skills --check             report drift, change nothing, no network
#   install-skills --dry-run           print what would change
#   install-skills --prune             also remove store entries not in profile
#
# A skill profile selects exact paths from source packs declared in
# manifests/skill-packs.tsv. Skill content is never vendored here.
set -euo pipefail

REPO_ROOT=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)
PACKS_MANIFEST=${SKILL_PACKS_MANIFEST:-$REPO_ROOT/manifests/skill-packs.tsv}
PROFILE_DIR=${SKILL_PROFILE_DIR:-$REPO_ROOT/manifests/skill-profiles}
PROFILE=${SKILLS_PROFILE:-default}
LEGACY_MANIFEST=${SKILLS_MANIFEST:-}
STORE=${AGENTS_SKILLS_DIR:-$HOME/.agents/skills}
CACHE=${WORKSTATION_CACHE:-$HOME/.cache/workstation}/skills
PROVENANCE=${AGENTS_DIR:-$HOME/.agents}/third-party-skills.tsv

MODE=install
DRY_RUN=0
PRUNE=0
LIST_PROFILES=0
declare -a ONLY=()

while [ $# -gt 0 ]; do
    case $1 in
        --profile)       PROFILE=${2:?--profile needs a name}; shift 2 ;;
        --resolve)       MODE=resolve; shift ;;
        --list-profiles) LIST_PROFILES=1; shift ;;
        --check)         MODE=check; shift ;;
        --dry-run)       DRY_RUN=1; shift ;;
        --prune)         PRUNE=1; shift ;;
        -h|--help)       sed -n '2,22p' "$0"; exit 0 ;;
        -*)              printf 'install-skills: unknown option: %s\n' "$1" >&2; exit 2 ;;
        *)               ONLY+=("$1"); shift ;;
    esac
done

if [ "$LIST_PROFILES" = 1 ]; then
    [ -d "$PROFILE_DIR" ] || { printf 'install-skills: profile directory not found: %s\n' "$PROFILE_DIR" >&2; exit 1; }
    for file in "$PROFILE_DIR"/*.tsv; do
        [ -f "$file" ] || continue
        basename "$file" .tsv
    done
    exit 0
fi

RED=''; GREEN=''; YELLOW=''; DIM=''; RESET=''
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'
    DIM=$'\033[2m'; RESET=$'\033[0m'
fi
ok()     { printf '  %sok%s      %s\n' "$GREEN" "$RESET" "$1"; }
change() { printf '  %schange%s  %s\n' "$YELLOW" "$RESET" "$1"; }
bad()    { printf '  %sFAIL%s    %s\n' "$RED" "$RESET" "$1"; FAILED=$(( FAILED + 1 )); }
info()   { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }

FAILED=0
INSTALLED=0
UPDATED=0

# Repository plumbing that must never become part of an installed skill. It
# matters most for a skill whose path is "." (the repository root IS the skill).
REPO_PLUMBING=(.git .github)
DIFF_EXCLUDES=()
for junk in "${REPO_PLUMBING[@]}"; do DIFF_EXCLUDES+=("--exclude=$junk"); done

wanted() {
    local name=$1 n
    [ "${#ONLY[@]}" -eq 0 ] && return 0
    for n in "${ONLY[@]}"; do [ "$n" = "$name" ] && return 0; done
    return 1
}

valid_name() {
    [[ $1 =~ ^[A-Za-z0-9._-]+$ ]]
}

valid_relpath() {
    local path=$1
    [ -n "$path" ] || return 1
    [ "${path#/}" = "$path" ] || return 1
    case "/$path/" in */../*|*/./../*|*/.././*) return 1 ;; esac
    return 0
}

join_path() {
    local root=$1 child=$2
    if [ "$root" = "." ]; then
        printf '%s\n' "$child"
    elif [ "$child" = "." ]; then
        printf '%s\n' "$root"
    else
        printf '%s/%s\n' "${root%/}" "${child#./}"
    fi
}

# Resolve to five columns:
#   name source ref path pack
# SKILLS_MANIFEST keeps compatibility with the old explicit four-column format.
resolve_profile() {
    if [ -n "$LEGACY_MANIFEST" ]; then
        [ -f "$LEGACY_MANIFEST" ] || {
            printf 'install-skills: manifest not found: %s\n' "$LEGACY_MANIFEST" >&2
            return 1
        }
        while IFS=$'\t' read -r name source ref path _rest; do
            case ${name:-} in ''|'#'*) continue ;; esac
            printf '%s\t%s\t%s\t%s\tlegacy\n' "$name" "$source" "$ref" "$path"
        done < "$LEGACY_MANIFEST"
        return 0
    fi

    [ -f "$PACKS_MANIFEST" ] || {
        printf 'install-skills: pack manifest not found: %s\n' "$PACKS_MANIFEST" >&2
        return 1
    }
    local profile_file=$PROFILE_DIR/$PROFILE.tsv
    [ -f "$profile_file" ] || {
        printf 'install-skills: profile not found: %s\n' "$PROFILE" >&2
        return 1
    }

    declare -A pack_source=()
    declare -A pack_ref=()
    declare -A pack_root=()
    local pack source ref root extra
    while IFS=$'\t' read -r pack source ref root extra; do
        case ${pack:-} in ''|'#'*) continue ;; esac
        if ! valid_name "$pack" || [ -z "${source:-}" ] || [ -z "${ref:-}" ] || ! valid_relpath "${root:-}"; then
            printf 'install-skills: malformed pack row: %s\n' "$pack" >&2
            return 1
        fi
        if [ -n "${pack_source[$pack]:-}" ]; then
            printf 'install-skills: duplicate pack: %s\n' "$pack" >&2
            return 1
        fi
        pack_source[$pack]=$source
        pack_ref[$pack]=$ref
        pack_root[$pack]=$root
    done < "$PACKS_MANIFEST"

    declare -A seen=()
    local name path resolved_path
    while IFS=$'\t' read -r name pack path extra; do
        case ${name:-} in ''|'#'*) continue ;; esac
        if ! valid_name "$name" || ! valid_name "${pack:-}" || ! valid_relpath "${path:-}"; then
            printf 'install-skills: malformed profile row for %s\n' "${name:-<empty>}" >&2
            return 1
        fi
        if [ -n "${seen[$name]:-}" ]; then
            printf 'install-skills: profile %s selects skill %s more than once (%s and %s)\n' \
                "$PROFILE" "$name" "${seen[$name]}" "$pack" >&2
            return 1
        fi
        if [ -z "${pack_source[$pack]:-}" ]; then
            printf 'install-skills: profile %s references unknown pack %s for %s\n' \
                "$PROFILE" "$pack" "$name" >&2
            return 1
        fi
        seen[$name]=$pack
        resolved_path=$(join_path "${pack_root[$pack]}" "$path")
        printf '%s\t%s\t%s\t%s\t%s\n' \
            "$name" "${pack_source[$pack]}" "${pack_ref[$pack]}" "$resolved_path" "$pack"
    done < "$profile_file"
}

RESOLVED=$(mktemp)
trap 'rm -f -- "$RESOLVED"' EXIT
if ! resolve_profile > "$RESOLVED"; then exit 1; fi

if [ "$MODE" = resolve ]; then
    cat "$RESOLVED"
    exit 0
fi

# Fail if a requested name does not exist in the selected profile.
if [ "${#ONLY[@]}" -gt 0 ]; then
    for requested in "${ONLY[@]}"; do
        if ! awk -F '\t' -v name="$requested" '$1 == name { found=1 } END { exit !found }' "$RESOLVED"; then
            printf 'install-skills: skill is not in profile %s: %s\n' "$PROFILE" "$requested" >&2
            exit 1
        fi
    done
fi

# --------------------------------------------------------------- check mode --
if [ "$MODE" = check ]; then
    printf 'skill store   %s\n' "$STORE"
    printf 'profile       %s\n\n' "$PROFILE"
    while IFS=$'\t' read -r name source ref _path pack; do
        wanted "$name" || continue
        if [ -f "$STORE/$name/SKILL.md" ]; then
            ok "$name  ($pack: $source@$ref)"
        else
            bad "$name is missing from the store ($pack: $source@$ref)"
        fi
    done < "$RESOLVED"
    if [ -d "$STORE" ]; then
        for dir in "$STORE"/*/; do
            [ -d "$dir" ] || continue
            n=$(basename "$dir")
            awk -F '\t' -v name="$n" '$1 == name { found=1 } END { exit !found }' "$RESOLVED" || \
                info "$n is in the store but not in profile $PROFILE"
        done
    fi
    printf '\n%d problem(s)\n' "$FAILED"
    if [ "$FAILED" -eq 0 ]; then exit 0; else exit 1; fi
fi

# ------------------------------------------------------------- install mode --
command -v git >/dev/null 2>&1 || { printf 'install-skills: git is required\n' >&2; exit 1; }
mkdir -p -- "$CACHE" "$STORE"

# sync_repo <source> <ref> -> sets SYNCED_REPO_DIR, or fails
declare -A REPO_SHA=()
declare -A REPO_DIR=()
SYNCED_REPO_DIR=
sync_repo() {
    local source=$1 ref=$2 key dir
    key="$source@$ref"
    if [ -n "${REPO_DIR[$key]:-}" ]; then SYNCED_REPO_DIR=${REPO_DIR[$key]}; return 0; fi
    dir=$CACHE/$(printf '%s' "$source" | sed 's|/|__|g')
    if [ -d "$dir/.git" ]; then
        git -C "$dir" fetch --quiet --prune --tags origin </dev/null || return 1
    else
        rm -rf -- "$dir"
        git clone --quiet --filter=blob:none "https://github.com/$source.git" "$dir" </dev/null || return 1
    fi
    git -C "$dir" checkout --quiet --detach "origin/$ref" </dev/null 2>/dev/null ||
        git -C "$dir" checkout --quiet --detach "$ref" </dev/null 2>/dev/null || return 1
    REPO_DIR[$key]=$dir
    REPO_SHA[$key]=$(git -C "$dir" rev-parse HEAD)
    SYNCED_REPO_DIR=$dir
}

: > "$PROVENANCE.new"
{
    printf '# Generated by bin/install-skills. Do not edit by hand.\n'
    printf '# name\tsource\tref\tresolved\tinstalled\tpack\n'
} >> "$PROVENANCE.new"
if [ "${#ONLY[@]}" -gt 0 ] && [ -f "$PROVENANCE" ]; then
    while IFS=$'\t' read -r old_name old_source old_ref old_sha old_date old_pack; do
        case ${old_name:-} in ''|'#'*) continue ;; esac
        wanted "$old_name" || printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$old_name" "$old_source" "$old_ref" "$old_sha" "$old_date" "${old_pack:-legacy}" >> "$PROVENANCE.new"
    done < "$PROVENANCE"
fi

while IFS=$'\t' read -r name source ref path pack; do
    wanted "$name" || continue

    if ! sync_repo "$source" "$ref"; then
        bad "$name: could not fetch $source@$ref"
        continue
    fi
    dir=$SYNCED_REPO_DIR
    src=$dir
    [ "$path" != "." ] && src=$dir/$path
    if [ ! -f "$src/SKILL.md" ]; then
        bad "$name: $source@$ref has no SKILL.md at '$path'"
        continue
    fi

    dest=$STORE/$name
    if [ -d "$dest" ] && diff -rq "${DIFF_EXCLUDES[@]}" -- "$src" "$dest" >/dev/null 2>&1; then
        ok "$name  ($pack: $source@$ref)"
    elif [ "$DRY_RUN" = 1 ]; then
        change "$name would be $( [ -d "$dest" ] && printf updated || printf installed ) from $pack: $source@$ref"
    else
        if [ -d "$dest" ]; then UPDATED=$(( UPDATED + 1 )); else INSTALLED=$(( INSTALLED + 1 )); fi
        rm -rf -- "$dest.new"
        cp -a -- "$src" "$dest.new"
        for junk in "${REPO_PLUMBING[@]}"; do rm -rf -- "$dest.new/$junk"; done
        rm -rf -- "$dest"
        mv -- "$dest.new" "$dest"
        change "$name  ($pack: $source@$ref)"
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$name" "$source" "$ref" "${REPO_SHA[$source@$ref]:-unknown}" "$(date -u +%Y-%m-%d)" "$pack" \
        >> "$PROVENANCE.new"
done < "$RESOLVED"

if [ "$PRUNE" = 1 ] && [ "${#ONLY[@]}" -eq 0 ]; then
    for dir in "$STORE"/*/; do
        [ -d "$dir" ] || continue
        n=$(basename "$dir")
        awk -F '\t' -v name="$n" '$1 == name { found=1 } END { exit !found }' "$RESOLVED" && continue
        if [ "$DRY_RUN" = 1 ]; then
            change "$n would be pruned (not in profile $PROFILE)"
        else
            rm -rf -- "$dir"
            change "$n pruned (not in profile $PROFILE)"
        fi
    done
fi

if [ "$DRY_RUN" = 1 ]; then
    rm -f -- "$PROVENANCE.new"
    info 'dry run: nothing was written'
else
    mv -f -- "$PROVENANCE.new" "$PROVENANCE"
fi

printf '\n%d installed, %d updated, %d failed\n' "$INSTALLED" "$UPDATED" "$FAILED"

if [ "$DRY_RUN" != 1 ]; then
    printf '\n-- sync-agent-skills --\n'
    sync=$HOME/.local/bin/sync-agent-skills
    [ -x "$sync" ] || sync=$REPO_ROOT/bin/sync-agent-skills
    "$sync"
fi

[ "$FAILED" -eq 0 ]
