#!/usr/bin/env bash
#
# install-skills - install and update the third-party agent skills declared in
# manifests/skills.tsv into the canonical store ~/.agents/skills.
#
#   install-skills                 install or update every skill in the manifest
#   install-skills tdd humanizer   only these skills
#   install-skills --check         report drift, change nothing, no network
#   install-skills --dry-run       print what would change
#   install-skills --prune         also remove store entries not in the manifest
#
# Skill content is never vendored into the workstation repository. Each source
# repository is cached under ~/.cache/workstation/skills, checked out at the ref
# from the manifest, and only the skill directory is copied into the store.
#
# The script finishes by running sync-agent-skills, which refreshes the
# per-skill Codex symlinks and leaves ~/.codex/skills/.system untouched.
set -euo pipefail

REPO_ROOT=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)
MANIFEST=${SKILLS_MANIFEST:-$REPO_ROOT/manifests/skills.tsv}
STORE=${AGENTS_SKILLS_DIR:-$HOME/.agents/skills}
CACHE=${WORKSTATION_CACHE:-$HOME/.cache/workstation}/skills
PROVENANCE=${AGENTS_DIR:-$HOME/.agents}/third-party-skills.tsv

MODE=install
DRY_RUN=0
PRUNE=0
declare -a ONLY=()

while [ $# -gt 0 ]; do
    case $1 in
        --check)   MODE=check; shift ;;
        --dry-run) DRY_RUN=1; shift ;;
        --prune)   PRUNE=1; shift ;;
        -h|--help) sed -n '2,18p' "$0"; exit 0 ;;
        -*)        printf 'install-skills: unknown option: %s\n' "$1" >&2; exit 2 ;;
        *)         ONLY+=("$1"); shift ;;
    esac
done

RED=''; GREEN=''; YELLOW=''; DIM=''; RESET=''
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'
    DIM=$'\033[2m'; RESET=$'\033[0m'
fi
ok()     { printf '  %sok%s      %s\n' "$GREEN" "$RESET" "$1"; }
change() { printf '  %schange%s  %s\n' "$YELLOW" "$RESET" "$1"; }
bad()    { printf '  %sFAIL%s    %s\n' "$RED" "$RESET" "$1"; FAILED=$(( FAILED + 1 )); }
info()   { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }

FAILED=0
INSTALLED=0
UPDATED=0

# Repository plumbing that must never become part of an installed skill. It
# matters most for a skill whose path is "." (the repository root IS the skill).
REPO_PLUMBING=(.git .github)
DIFF_EXCLUDES=()
for junk in "${REPO_PLUMBING[@]}"; do DIFF_EXCLUDES+=("--exclude=$junk"); done

[ -f "$MANIFEST" ] || { printf 'install-skills: manifest not found: %s\n' "$MANIFEST" >&2; exit 1; }

wanted() {
    local name=$1 n
    [ "${#ONLY[@]}" -eq 0 ] && return 0
    for n in "${ONLY[@]}"; do [ "$n" = "$name" ] && return 0; done
    return 1
}

# --------------------------------------------------------------- check mode --
if [ "$MODE" = check ]; then
    printf 'skill store   %s\n' "$STORE"
    printf 'manifest      %s\n\n' "$MANIFEST"
    while IFS=$'\t' read -r name source ref path; do
        case ${name:-} in ''|'#'*) continue ;; esac
        wanted "$name" || continue
        if [ -f "$STORE/$name/SKILL.md" ]; then
            ok "$name  ($source@$ref)"
        else
            bad "$name is missing from the store ($source@$ref)"
        fi
    done < "$MANIFEST"
    # store entries that the manifest does not declare
    if [ -d "$STORE" ]; then
        for dir in "$STORE"/*/; do
            [ -d "$dir" ] || continue
            n=$(basename "$dir")
            grep -q "^$n"$'\t' "$MANIFEST" || info "$n is in the store but not in the manifest"
        done
    fi
    printf '\n%d problem(s)\n' "$FAILED"
    if [ "$FAILED" -eq 0 ]; then exit 0; else exit 1; fi
fi

# ------------------------------------------------------------- install mode --
command -v git >/dev/null 2>&1 || { printf 'install-skills: git is required\n' >&2; exit 1; }
mkdir -p -- "$CACHE" "$STORE"

# sync_repo <source> <ref> -> prints the cache checkout path, or fails
declare -A REPO_SHA=()
declare -A REPO_DIR=()
sync_repo() {
    local source=$1 ref=$2 key dir
    key="$source@$ref"
    if [ -n "${REPO_DIR[$key]:-}" ]; then printf '%s' "${REPO_DIR[$key]}"; return 0; fi
    dir=$CACHE/$(printf '%s' "$source" | sed 's|/|__|g')
    if [ -d "$dir/.git" ]; then
        git -C "$dir" fetch --quiet --prune --tags origin </dev/null || return 1
    else
        rm -rf -- "$dir"
        git clone --quiet --filter=blob:none "https://github.com/$source.git" "$dir" </dev/null || return 1
    fi
    # ref may be a branch, a tag or a commit SHA.
    git -C "$dir" checkout --quiet --detach "origin/$ref" </dev/null 2>/dev/null ||
        git -C "$dir" checkout --quiet --detach "$ref" </dev/null 2>/dev/null || return 1
    REPO_DIR[$key]=$dir
    REPO_SHA[$key]=$(git -C "$dir" rev-parse HEAD)
    printf '%s' "$dir"
}

: > "$PROVENANCE.new"
{
    printf '# Generated by bin/install-skills. Do not edit by hand.\n'
    printf '# name\tsource\tref\tresolved\tinstalled\n'
} >> "$PROVENANCE.new"

while IFS=$'\t' read -r name source ref path; do
    case ${name:-} in ''|'#'*) continue ;; esac
    [ -n "${source:-}" ] && [ -n "${ref:-}" ] && [ -n "${path:-}" ] || {
        bad "malformed manifest row for '$name'"; continue; }
    wanted "$name" || continue

    if ! dir=$(sync_repo "$source" "$ref"); then
        bad "$name: could not fetch $source@$ref"
        continue
    fi
    src=$dir
    [ "$path" != "." ] && src=$dir/$path
    if [ ! -f "$src/SKILL.md" ]; then
        bad "$name: $source@$ref has no SKILL.md at '$path'"
        continue
    fi

    dest=$STORE/$name
    if [ -d "$dest" ] && diff -rq "${DIFF_EXCLUDES[@]}" -- "$src" "$dest" >/dev/null 2>&1; then
        ok "$name  ($source@$ref)"
    elif [ "$DRY_RUN" = 1 ]; then
        change "$name would be $( [ -d "$dest" ] && printf updated || printf installed ) from $source@$ref"
    else
        if [ -d "$dest" ]; then UPDATED=$(( UPDATED + 1 )); else INSTALLED=$(( INSTALLED + 1 )); fi
        rm -rf -- "$dest.new"
        cp -a -- "$src" "$dest.new"
        for junk in "${REPO_PLUMBING[@]}"; do rm -rf -- "$dest.new/$junk"; done
        rm -rf -- "$dest"
        mv -- "$dest.new" "$dest"
        change "$name  ($source@$ref)"
    fi
    printf '%s\t%s\t%s\t%s\t%s\n' \
        "$name" "$source" "$ref" "${REPO_SHA[$source@$ref]:-unknown}" "$(date -u +%Y-%m-%d)" \
        >> "$PROVENANCE.new"
done < "$MANIFEST"

if [ "$PRUNE" = 1 ] && [ "${#ONLY[@]}" -eq 0 ]; then
    for dir in "$STORE"/*/; do
        [ -d "$dir" ] || continue
        n=$(basename "$dir")
        grep -q "^$n"$'\t' "$MANIFEST" && continue
        if [ "$DRY_RUN" = 1 ]; then
            change "$n would be pruned (not in the manifest)"
        else
            rm -rf -- "$dir"
            change "$n pruned (not in the manifest)"
        fi
    done
fi

if [ "$DRY_RUN" = 1 ]; then
    rm -f -- "$PROVENANCE.new"
    info 'dry run: nothing was written'
else
    mv -f -- "$PROVENANCE.new" "$PROVENANCE"
fi

printf '\n%d installed, %d updated, %d failed\n' "$INSTALLED" "$UPDATED" "$FAILED"

if [ "$DRY_RUN" != 1 ]; then
    printf '\n-- sync-agent-skills --\n'
    sync=$HOME/.local/bin/sync-agent-skills
    [ -x "$sync" ] || sync=$REPO_ROOT/bin/sync-agent-skills
    "$sync"
fi

[ "$FAILED" -eq 0 ]
