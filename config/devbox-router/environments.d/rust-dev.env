# Rust development environment managed by rustup.
#
# Cargo and rustup are NOT configured here: the rust-dev container's own
# ~/.bashrc.d puts the isolated CARGO_HOME on PATH, and login_shell=1 makes
# that happen. Environment-specific initialisation belongs to the environment,
# not to the router.
description = Rust (rustup + cargo) development
box = rust-dev
workspace_host = ~/projects
workspace_guest = /workspace
login_shell = 1
