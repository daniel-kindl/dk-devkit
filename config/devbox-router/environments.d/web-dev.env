# Node / pnpm / web development environment.
#
# NVM is intentionally NOT configured here: the web-dev container's own
# ~/.bashrc loads it, and login_shell=1 makes that happen. Environment-specific
# initialisation belongs to the environment, not to the router.
description = Node 22 (nvm) + pnpm web development
box = web-dev
workspace_host = ~/projects
workspace_guest = /workspace
login_shell = 1
