# devbox router - global settings
#
# Environment used by agent shims when the working directory is not inside a
# Git repository (Claude/Codex "management" environment).
default_environment = web-dev

# Mirror Orca's Claude Code hooks/statusline into the container HOME so that
# Orca keeps seeing agent activity even though Claude runs inside a Distrobox.
# Only ever fills in keys that are absent or still hold the value devbox wrote.
orca_integration = 1
