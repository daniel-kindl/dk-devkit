{
  "version": 1,
  "id": "android-dev",
  "name": "android-dev environment",
  "kind": "environment",
  "group": "Development environments",
  "status": "supported",
  "summary": "Fedora Distrobox with JDK 25, the Android SDK, an Android emulator and the Gradle wrapper toolchain.",
  "requires": ["distrobox", "devbox"],
  "capabilities": ["linux", "host", "distrobox", "container-runtime"],
  "unattended": true,
  "commands": ["android-emulator-controls"],
  "install": ["components/android-dev/install.sh"],
  "doctor": ["components/android-dev/doctor.sh"],
  "verify": ["./verify.sh", "--only", "27"],
  "manual": [
    "Authenticate Claude Code, Codex and Grok inside android-dev if you use them.",
    "Start the Android emulator in android-dev: emulator -avd android-dev-36 -gpu host.",
    "Open the Android Emulator controls: android-emulator-controls."
  ],
  "environment": {
    "container": "android-dev",
    "ini": "distrobox/android-dev.ini",
    "packages": "manifests/android-dev-packages.txt",
    "toolchain": "manifests/android-dev.env",
    "bootstrap": "bootstrap/android-dev.sh",
    "router": "config/devbox-router/environments.d/android-dev.env",
    "inference": "components/android-dev/inference.tsv",
    "home": "~/.local/share/distrobox-homes/android-dev/"
  },
  "state": {
    "public": ["bin/android-emulator-controls", "components/android-dev/doctor.sh", "distrobox/android-dev.ini", "manifests/android-dev-packages.txt", "manifests/android-dev.env"],
    "local": ["~/.local/bin/android-emulator-controls", "~/.local/share/distrobox-homes/android-dev/"]
  }
}
