{
  "version": 1,
  "id": "repo-labels",
  "name": "repository label tool",
  "kind": "tool",
  "group": "Repository tooling",
  "summary": "Checks or converges a GitHub repository to the canonical label manifest.",
  "requires": [],
  "capabilities": [
    "gh",
    "python3"
  ],
  "unattended": true,
  "commands": [
    "repo-labels"
  ],
  "install": [
    "components/repo-labels/install.sh"
  ],
  "doctor": [
    "components/repo-labels/doctor.sh"
  ],
  "verify": [
    "./verify.sh",
    "--only",
    "86"
  ],
  "manual": [
    "Authenticate the GitHub CLI where you run repo-labels: gh auth login."
  ],
  "state": {
    "public": [
      "manifests/github-labels.json"
    ],
    "local": []
  }
}
