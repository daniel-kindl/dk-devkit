{
  "version": 1,
  "id": "rust-dev",
  "name": "rust-dev environment",
  "kind": "environment",
  "group": "Development environments",
  "status": "supported",
  "summary": "Fedora Distrobox with an isolated home and the Rust/rustup toolchain.",
  "requires": ["distrobox", "devbox"],
  "capabilities": ["linux", "host", "distrobox", "container-runtime"],
  "unattended": true,
  "install": ["components/rust-dev/install.sh"],
  "doctor": null,
  "verify": ["./verify.sh", "--only", "26"],
  "manual": [],
  "environment": {
    "container": "rust-dev",
    "ini": "distrobox/rust-dev.ini",
    "packages": "manifests/rust-dev-packages.txt",
    "toolchain": "manifests/rust-dev.env",
    "bootstrap": "bootstrap/rust-dev.sh",
    "router": "config/devbox-router/environments.d/rust-dev.env",
    "inference": "components/rust-dev/inference.tsv",
    "home": "~/.local/share/distrobox-homes/rust-dev/"
  },
  "state": {
    "public": ["distrobox/rust-dev.ini", "manifests/rust-dev-packages.txt", "manifests/rust-dev.env"],
    "local": ["~/.local/share/distrobox-homes/rust-dev/"]
  }
}
