{
  "version": 1,
  "id": "agent-skills",
  "name": "third-party agent skills",
  "kind": "tool",
  "group": "Core tools",
  "summary": "Resolves a curated skill profile from third-party source packs, installs it into the canonical store, and refreshes agent links.",
  "requires": [],
  "capabilities": ["linux", "git"],
  "unattended": true,
  "install": ["components/agent-skills/install.sh"],
  "doctor": ["bin/install-skills", "--check"],
  "verify": ["./verify.sh", "--only", "35"],
  "manual": [],
  "state": {
    "public": ["manifests/skill-packs.tsv", "manifests/skill-profiles/"],
    "local": ["~/.agents/skills/", "~/.agents/third-party-skills.tsv"]
  }
}
