{
  "version": 1,
  "id": "dotnet-dev",
  "name": "dotnet-dev environment",
  "kind": "environment",
  "group": "Development environments",
  "status": "supported",
  "summary": "Fedora Distrobox with an isolated home and the .NET SDK for C# development.",
  "requires": ["distrobox", "devbox"],
  "capabilities": ["linux", "host", "distrobox", "container-runtime"],
  "unattended": true,
  "install": ["components/dotnet-dev/install.sh"],
  "doctor": null,
  "verify": ["./verify.sh", "--only", "29"],
  "manual": [
    "Authenticate Claude Code and Codex inside dotnet-dev if you use them."
  ],
  "environment": {
    "container": "dotnet-dev",
    "ini": "distrobox/dotnet-dev.ini",
    "packages": "manifests/dotnet-dev-packages.txt",
    "toolchain": "manifests/dotnet-dev.env",
    "bootstrap": "bootstrap/dotnet-dev.sh",
    "router": "config/devbox-router/environments.d/dotnet-dev.env",
    "inference": "components/dotnet-dev/inference.tsv",
    "home": "~/.local/share/distrobox-homes/dotnet-dev/"
  },
  "state": {
    "public": ["distrobox/dotnet-dev.ini", "manifests/dotnet-dev-packages.txt", "manifests/dotnet-dev.env"],
    "local": ["~/.local/share/distrobox-homes/dotnet-dev/"]
  }
}
