# Pinned toolchain versions for the web-dev environment.
# bootstrap/web-dev.sh reads this file. Change a version here, re-run the
# bootstrap, and the environment converges on the new version.

# nvm itself. Installed into $NVM_DIR, which is NOT the nvm default.
NVM_VERSION=0.40.7
NVM_DIR_REL=.config/nvm

# Node. Matches the .nvmrc of the primary project checkout.
NODE_VERSION=22.13.1

# Corepack is pinned because Node 22 ships an older Corepack that cannot
# activate the pnpm version below.
COREPACK_VERSION=0.31.0

# pnpm. Matches "packageManager" in the primary project checkout.
PNPM_VERSION=11.25.0

# Agent CLIs. Both are native installers, not npm packages. They self-update,
# so these are the versions that were verified, not hard pins.
CLAUDE_CODE_INSTALLER=https://claude.ai/install.sh
CLAUDE_CODE_VERIFIED=2.1.261
CODEX_INSTALLER=https://chatgpt.com/codex/install.sh
CODEX_VERIFIED=0.153.2
