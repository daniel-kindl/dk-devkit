# Pinned internal defaults for the GitHub backlog coordinator (agentq).
#
# The file name and AGENTQUEUE_* variable names are durable internal config
# identifiers. The supported user-facing executable is `agentq`.
#
# agentq is the TRUSTED half of the unattended pipeline. It holds the GitHub
# authority that a sandbox never gets: it reads issues, pushes branches, opens
# pull requests and merges them. agentbox stays the untrusted half.

# --- identity ---------------------------------------------------------------
AGENTQUEUE_VERSION=0.3.0

# --- where the runtime lives ------------------------------------------------
# The development environment that owns the coordinator. It needs gh and the
# forwarded ssh-agent, and both are reachable there.
#
# bootstrap/web-dev.sh installs the real command inside this environment.
# bootstrap/host.sh installs a router shim of the same name on the host, pinned
# to this environment, so that "agentq run" works from a normal host terminal.
AGENTQUEUE_ENVIRONMENT=web-dev

# The options whose value is a host DIRECTORY. The host shim is generated with
# "devbox new-shim --map-path" for each of them, so the router translates the
# value into the container the same way it translates the working directory.
#
# Without this, "agentq run --repo ~/projects/dkkb" typed on the host would
# hand the coordinator a host path that does not exist inside the container.
# Every spelling of a directory is translated. A relative value resolves
# against the HOST working directory first. A leading "~" expands against the
# host home. Comma-separated; every name must be a long option.
AGENTQUEUE_HOST_PATH_OPTIONS=--repo

# --- the lifecycle labels ---------------------------------------------------
AGENTQUEUE_ISSUE_LABEL=ready-for-agent
AGENTQUEUE_IN_PROGRESS_LABEL=agent-in-progress
AGENTQUEUE_HUMAN_LABEL=ready-for-human
AGENTQUEUE_FAILED_LABEL=agent-failed

# --- scheduling -------------------------------------------------------------
AGENTQUEUE_MAX_PARALLEL=1

# The retry budget for ONE issue. It covers both a failing deterministic check
# and a failing GitHub check. A budget of 2 allows three attempts in total.
AGENTQUEUE_MAX_RETRIES=2

# The number of implement-then-check rounds INSIDE one sandbox.
AGENTQUEUE_MAX_FIX_ROUNDS=2

# --- GitHub checks ----------------------------------------------------------
AGENTQUEUE_CI_TIMEOUT_SECONDS=1800
AGENTQUEUE_CI_POLL_SECONDS=20
AGENTQUEUE_CI_GRACE_SECONDS=180

# --- claims -----------------------------------------------------------------
AGENTQUEUE_STALE_CLAIM_SECONDS=7200

# --- the run scratch area ---------------------------------------------------
# Historical state directory name is preserved intentionally across the CLI
# rename so in-flight/recoverable run evidence does not move.
AGENTQUEUE_STATE_DIRNAME=agentqueue
