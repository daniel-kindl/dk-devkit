# Pinned defaults for the GitHub backlog coordinator (agentqueue).
#
# bin/agentqueue and bootstrap/lib/agentqueue.sh read this file. A repository
# policy file overrides any value here. See docs/agentqueue.md.
#
# agentqueue is the TRUSTED half of the unattended pipeline. It holds the
# GitHub authority that a sandbox never gets: it reads issues, pushes branches,
# opens pull requests and merges them. agentbox stays the untrusted half.

# --- identity ---------------------------------------------------------------
AGENTQUEUE_VERSION=0.1.0

# --- where the runtime lives ------------------------------------------------
# The development environment that owns the coordinator. It needs gh and the
# forwarded ssh-agent, and both are reachable there.
#
# bootstrap/web-dev.sh installs the real command inside this environment.
# bootstrap/host.sh installs a router shim of the same name on the host, pinned
# to this environment, so that "agentqueue drain --repo ." works from a normal
# host terminal. Change this value and both halves follow it.
AGENTQUEUE_ENVIRONMENT=web-dev

# --- the lifecycle labels ---------------------------------------------------
# An issue carries at most one of these at a time. The queue reads and writes
# them, so they are durable state that survives a killed coordinator.
AGENTQUEUE_ISSUE_LABEL=ready-for-agent
AGENTQUEUE_IN_PROGRESS_LABEL=agent-in-progress
AGENTQUEUE_HUMAN_LABEL=ready-for-human
AGENTQUEUE_FAILED_LABEL=agent-failed

# --- scheduling -------------------------------------------------------------
# One repository, one agent at a time. Parallel scheduling works, but it is not
# the default: two agents on one repository share a base branch, and a merge by
# one invalidates the CI result of the other.
AGENTQUEUE_MAX_PARALLEL=1

# The retry budget for ONE issue. It covers both a failing deterministic check
# and a failing GitHub check. A budget of 2 allows three attempts in total.
AGENTQUEUE_MAX_RETRIES=2

# The number of implement-then-check rounds INSIDE one sandbox. The sandbox
# runs the repository checks after the implementer, feeds a failure back to the
# same agent, and repeats. This is the cheap loop; AGENTQUEUE_MAX_RETRIES is
# the expensive one, because each retry is a new clone and a new sandbox.
AGENTQUEUE_MAX_FIX_ROUNDS=2

# --- GitHub checks ----------------------------------------------------------
# How long the coordinator waits for the required GitHub checks of one head
# commit, and how often it asks.
AGENTQUEUE_CI_TIMEOUT_SECONDS=1800
AGENTQUEUE_CI_POLL_SECONDS=20

# A pull request that reports no check at all after this many seconds is not
# treated as a pass. The queue fails closed and asks for a human.
AGENTQUEUE_CI_GRACE_SECONDS=180

# --- claims -----------------------------------------------------------------
# A claim older than this, with no release comment, is stale. The default is
# twice the agentbox wall-clock limit, so a live run is never mistaken for a
# dead one.
AGENTQUEUE_STALE_CLAIM_SECONDS=7200

# --- the run scratch area ---------------------------------------------------
# Prompts, agentbox logs and run records. It holds no credential.
AGENTQUEUE_STATE_DIRNAME=agentqueue
