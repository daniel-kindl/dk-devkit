# Pinned baseline for the reusable godot-dev environment.
#
# The C# build of Godot is the "mono" build. The standard build has no C#
# support, and the distribution package is the standard build, so the engine
# comes from the upstream release and not from dnf.
#
# The repository owns the target framework and the project dependencies through
# .csproj, .sln and project.godot.

GODOT_VERSION=4.7.2
GODOT_RELEASE=stable
GODOT_FLAVOR=mono

# The published SHA-512 of Godot_v4.7.2-stable_mono_linux_x86_64.zip, from the
# SHA512-SUMS.txt of the same release. Change the version, change this digest.
GODOT_SHA512=1855960b27ee3ef5e66e5e228cced69d55637b24334a7411162687dcd077d8f9f645348cdb8eae984bec8135d49ed855a1e3a16476786b8bce60774fd8402d13

# The export templates are a 1.2G download and only an export needs them, so
# the bootstrap reports the step instead of doing it. docs/godot-dev.md gives
# the command. This digest checks that download.
GODOT_TEMPLATES_SHA512=bb5c41d72370ed743660361f6228006f808ab04ca33abdc545d740b044f3fe057f32ae8cb7873a1bc86ddcd82ae683b9f6dfdfe4179852f2c0f1acde2ff6bd5a

# Where the engine is unpacked, and where the .NET CLI keeps its state. Both
# are relative to the isolated container HOME. The engine stays out of
# ~/.local/share/godot, which is the directory Godot itself manages: the editor
# keeps the export templates and the per-project user data there.
GODOT_ROOT_REL=.local/share/godot-engine
DOTNET_CLI_HOME_REL=.dotnet
