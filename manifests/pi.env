# Pinned versions and locations for the HOST Pi installation.
#
# Pi is a host control-plane tool. There is exactly ONE installation, and it
# runs on the host, so this manifest is not part of any development
# environment. manifests/toolchain.env belongs to web-dev and stays that way.
#
# bootstrap/lib/pi.sh reads this file. Change a value here, run the component
# again, and the host converges on it.

# --- the package ------------------------------------------------------------
# Pi is distributed as an npm package. The pi.dev installer is a convenience
# wrapper around the same "npm install -g" command, so the component installs
# the package directly and runs no remote shell script.
PI_PACKAGE=@earendil-works/pi-coding-agent

# Pi updates itself with "pi update --self", so this is the version that was
# verified, not a hard pin. The component installs the current release.
PI_VERIFIED=0.85.1

# --- the private Node runtime ----------------------------------------------
# Pi needs Node, and the host must not gain a Node development toolchain. The
# component therefore installs Pi's own private runtime, in the same location
# and the same layout that the pi.dev installer uses for a standalone Node.
# Nothing but Pi ever sees it: it is not on the host PATH, and only the
# generated ~/.local/bin/pi launcher puts it on the PATH of the Pi process.
PI_NODE_MIN_VERSION=22.19.0
PI_NODE_CHANNEL=latest-v22.x
PI_NODE_DIST_BASE=https://nodejs.org/dist
PI_NODE_VERIFIED=22.23.2

# --- where the installation lives -------------------------------------------
# Every path is relative to the home directory. They are machine-local state,
# and components/pi/component.json declares them as such.
PI_RUNTIME_DIR_REL=.local/share/pi-node
PI_PREFIX_REL=.local/share/pi/npm
PI_LAUNCHER_REL=.local/bin/pi

# Pi's own configuration, authentication and session directory. Pi owns it.
# The component writes exactly one file in it: the AGENTS.md link that points
# at the shared policy this repository tracks.
PI_AGENT_DIR_REL=.pi/agent

# --- provenance -------------------------------------------------------------
# The official installer was read before this component was written. It is
# recorded here as the reference for what an upstream installation does, and
# it is never executed by this repository.
PI_INSTALLER_REFERENCE=https://pi.dev/install.sh
