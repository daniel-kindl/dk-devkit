# Pinned baseline for Android development. JDK 25 can compile projects that target Java 17.
# The Gradle wrapper in each repository owns the Gradle version.
JAVA_HOME_REL=/usr/lib/jvm/java-25-openjdk
ANDROID_SDK_ROOT_REL=android-sdk
ANDROID_CMDLINE_TOOLS_VERSION=13114758
ANDROID_PLATFORM=android-37.0
ANDROID_BUILD_TOOLS=37.0.0
ANDROID_PACKAGES="platform-tools platforms;android-37.0 build-tools;37.0.0"
