# The pinned upstream .NET SDK, shared by dotnet-dev and godot-dev.
#
# A repository declares the SDK it needs in global.json, and that pin names a
# feature band: 10.0.401 is band 4xx, 10.0.111 is band 1xx. Every rollForward
# policy selects a version equal to or higher than the pinned one, and none of
# them moves down a band. Fedora packages band 1xx only, so a repository that
# pins band 4xx cannot build against dotnet-sdk-10.0, whatever rollForward it
# sets.
#
# The environment therefore installs the upstream SDK and puts it in front of
# the distribution package. The repository keeps the pin, and the container can
# honour it. This is a version-band rule for every C# repository, not a rule
# for one of them.
#
# The digest is the published SHA-512 of the linux-x64 tarball, from the
# release index at
# https://github.com/dotnet/core/blob/main/release-notes/10.0/releases.json.
# Change the version, change this digest.

DOTNET_SDK_VERSION=10.0.401
DOTNET_SDK_SHA512=51c8b999af9e8dd9998c9edc5944e19a90788862068acd38694e098889054ce8c23d4f0c5cccfa16bf187d044562359e5ee69a9f8ad0bbe913ba90311fbce25b

# Where the SDK is unpacked, relative to the isolated container HOME. The
# layout is side-by-side: a second version adds a directory under sdk/ and
# leaves every other version in place.
DOTNET_SDK_ROOT_REL=.local/share/dotnet
