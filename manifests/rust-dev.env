# Pinned tool versions for the reusable rust-dev environment.
#
# The Rust toolchain is pinned here as a BASELINE, not as a project
# requirement. A repository owns its toolchain through rust-toolchain.toml, and
# rustup installs that toolchain into the isolated container HOME when the
# repository asks for one. The baseline is what a repository gets when it asks
# for nothing.

# The default toolchain rustup installs, and the profile it installs it with.
# "minimal" plus the two components below is rustfmt and clippy without the
# offline documentation, which the container does not need.
RUST_VERSION=1.98.1
RUST_PROFILE=minimal
RUST_COMPONENTS=rustfmt,clippy

# rustup itself. It self-updates through "rustup self update", so this is the
# version that was verified, not a hard pin.
RUSTUP_INSTALLER=https://sh.rustup.rs
RUSTUP_VERIFIED=1.29.1

# rustup writes both of these into the isolated container HOME. They are named
# here because bootstrap/rust-dev.sh and the shell integration must agree.
RUSTUP_HOME_REL=.rustup
CARGO_HOME_REL=.cargo
