# Pinned versions for the Sandcastle agent-orchestration subsystem.
#
# bin/agentbox and bootstrap/host.sh read this file. Change a version here,
# run "agentbox build --force" for the built-in web image, or use
# "agent-sandbox build <profile> --force" for a named sandbox profile.
#
# See docs/sandcastle.md for the architecture.

# --- Sandcastle itself -------------------------------------------------------
# The orchestration library. Pinned exactly: an unattended agent runner must
# not change behaviour because an upstream release appeared.
SANDCASTLE_PACKAGE=@ai-hero/sandcastle
SANDCASTLE_VERSION=0.12.0

# --- the control plane image (agent-runner) ---------------------------------
# Fedora 44 matches the web-dev base and, more importantly, packages the exact
# podman-remote that the host runs. A client/server version match keeps the
# remote API predictable.
RUNNER_IMAGE=localhost/workstation/agent-runner
RUNNER_TAG=0.1.0
RUNNER_BASE=registry.fedoraproject.org/fedora:44
RUNNER_PODMAN_REMOTE_VERIFIED=5.8.4
RUNNER_NODE_VERIFIED=22.23.1

# --- sandbox profiles --------------------------------------------------------
# The sandbox profiles, in display order, as <name>:<prefix> entries. Profile
# <name> builds containers/sandbox-<name>/Containerfile. Its pins are
# <prefix>_IMAGE, <prefix>_TAG and <prefix>_BASE, and <prefix>_BUILD_ARGS adds
# build arguments. The image must be a localhost/ image. bin/agent-sandbox,
# bin/agentbox and lib/agentqueue/sandbox.py read this list, and
# docs/agent-sandbox-profiles.md explains how a repository selects a profile.
SANDBOX_PROFILES="web:SANDBOX python:SANDBOX_PYTHON"

# --- web sandbox profile -----------------------------------------------------
# The historical sandbox and the backward-compatible default. Node 22 matches
# manifests/toolchain.env NODE_VERSION line.
SANDBOX_IMAGE=localhost/workstation/sandbox-web
# 0.2.0 moves the pnpm store out of the repository. See the Containerfile.
SANDBOX_TAG=0.2.0
SANDBOX_BASE=docker.io/library/node:22-bookworm-slim
SANDBOX_NODE_VERIFIED=22.23.2

# --- Python sandbox profile --------------------------------------------------
# Python itself is deliberately not pinned in the image. The repository owns
# its interpreter through pyproject.toml and/or .python-version, and uv installs
# that interpreter inside the disposable sandbox HOME.
SANDBOX_PYTHON_IMAGE=localhost/workstation/sandbox-python
SANDBOX_PYTHON_TAG=0.1.0
SANDBOX_PYTHON_BASE=docker.io/library/debian:bookworm-slim
# The uv release that the image copies its binary from. The Containerfile has
# no default for UV_VERSION, so this line is the only uv pin.
SANDBOX_PYTHON_BUILD_ARGS="UV_VERSION=0.12.10"

# --- defaults ---------------------------------------------------------------
# The implementer and the independent reviewer a standalone "agentbox" run
# gets when the caller names no model.
#
# These two lines are a fallback, not the routing policy. agentq resolves an
# effort tier for each issue and passes the pinned model IDs of that tier on
# the command line, so a run it drives never reads these. The tier catalog is
# manifests/model-tiers.json, and docs/agentq.md explains how a tier is chosen.
#
# The values below are the standard tier, because ordinary work is what a
# standalone run usually is. Name --model and --review-model to run another.
AGENTBOX_MODEL=claude-sonnet-5
AGENTBOX_REVIEW_MODEL=gpt-5.6-terra

# The Git identity every disposable clone is given at clone time, before the
# integrity baseline is recorded and before any agent runs.
#
# A clone with no identity is what caused an agent to write one of its own:
# Sandcastle copies user.name and user.email out of the repository it drives
# into the sandbox, finds nothing when there is nothing to find, and the agent
# CLI then configures its own fallback identity the first time it commits.
# That write lands in the disposable clone's .git/config AFTER the baseline is
# taken, so the clone integrity comparison correctly reports a config change
# and refuses an otherwise normal result.
#
# The identity is neutral on purpose. It is a machine that ran unattended, not
# a person, and it is set ONLY in the disposable clone. An imported commit
# therefore carries "Agent <agent@local>" as its author and committer.
AGENTBOX_GIT_NAME=Agent
AGENTBOX_GIT_EMAIL=agent@local

# The branch prefix that agentbox refuses to work outside of. An agent never
# touches a branch that does not start with this, and it is the only namespace
# a validated result can be imported into.
AGENTBOX_BRANCH_PREFIX=agent/

# --- run limits -------------------------------------------------------------
# The wall-clock limit for one run, in seconds. --max-iterations bounds the
# number of agent turns; this bounds how long the whole run may take.
AGENTBOX_TIMEOUT_SECONDS=3600

# The most commits one validated import may carry. A result larger than this
# is refused rather than imported, because an unattended run that produced it
# is one a human should look at first.
AGENTBOX_MAX_COMMITS=20
# How many times the sandbox may re-run the implementer against its own failing
# checks, inside one sandbox, before the run ends.
#
# This is the cheap feedback loop. The agent stops, the sandbox runs the
# configured checks, and a failure goes straight back to the same agent with
# the failing command and the tail of its output. Nothing is cloned again and
# no container is created again.
#
# The expensive loop lives in agentq: a retry there is a whole new clone,
# a whole new sandbox and a whole new agent session.
AGENTBOX_MAX_FIX_ROUNDS=2

# --- the efficiency budget ---------------------------------------------------
# The limits that measure WORK rather than silence, applied to ONE model
# invocation. Sandcastle's idle timeout sees an agent that stops talking, and
# AGENTBOX_TIMEOUT_SECONDS sees a run that takes too long. Neither sees an
# agent that stays busy and gets nowhere, which is what these bound.
#
# A soft limit reports an efficiency warning in the run evidence and lets the
# invocation finish. A hard limit stops the agent, keeps every log and commit
# as evidence, and imports NOTHING: agentbox exits 12.
#
# The starting values come from the observed run that motivated them: a bounded
# documentation issue that reached 26 minutes and 64 tool calls. They are a
# starting point to measure against, not a constant. Set one to 0 to turn that
# limit off, and keep each soft limit below its hard limit.
AGENTBOX_SOFT_BUDGET_SECONDS=600
AGENTBOX_HARD_BUDGET_SECONDS=1200
AGENTBOX_SOFT_TOOL_CALLS=30
AGENTBOX_HARD_TOOL_CALLS=60
