# The pinned definition of the Windows virtual machine that agents reach.
#
# bin/winbox reads this file. It is the only place a version, a size or a port
# is written down, so a change here is the whole change.
#
# See docs/windows-vm.md for the architecture and the trust decision.

# --- the image that runs the virtual machine --------------------------------
# A container that runs QEMU, downloads the Microsoft installation media on
# first start, and answers the Windows installer from an unattended file. The
# tag is pinned exactly: an unattended installation must not change behaviour
# because an upstream release appeared.
WINDOWS_VM_IMAGE=docker.io/dockurr/windows
WINDOWS_VM_TAG=6.05

# --- which Windows -----------------------------------------------------------
# "2025" is the Windows Server 2025 evaluation edition. It needs no product
# key, it runs for 180 days, and it carries the OpenSSH server already, so the
# first boot does not have to download one. Other values the image accepts
# include 11, 10 and 2022; a client edition needs a licence of your own.
WINDOWS_VM_VERSION=2025

# --- the machine -------------------------------------------------------------
# The memory and the cores the virtual machine gets, and the size of its disk.
# The disk file grows as Windows writes, so the value is a limit, not a
# reservation. Windows Server 2025 needs about 15G after installation.
WINDOWS_VM_RAM=4G
WINDOWS_VM_CPU_CORES=2
WINDOWS_VM_DISK=64G

# --- identity ---------------------------------------------------------------
# The Windows account the agent logs in as. The account is an administrator,
# because the OpenSSH server puts an administrator key in a different file.
#
# There is NO password here. bin/winbox makes one at the first "winbox up",
# writes it to the machine-local environment file with mode 0600, and passes
# that file to Podman with --env-file. A credential value is never an argument
# and never enters this repository.
WINDOWS_VM_USERNAME=agent

# --- the container -----------------------------------------------------------
WINDOWS_VM_CONTAINER=windows-vm

# Where each port is published. Both are bound to the loopback address: the
# virtual machine answers this machine, and nothing else on the network.
#
# SSH is the channel an agent uses. The web viewer shows the QEMU console in a
# browser, which is how a human watches the installation and recovers a machine
# that no longer answers SSH.
WINDOWS_VM_SSH_PORT=2222
WINDOWS_VM_VIEWER_PORT=8006
WINDOWS_VM_BIND=127.0.0.1

# --- timeouts ---------------------------------------------------------------
# How long Podman waits for Windows to shut down before it stops the container.
WINDOWS_VM_STOP_TIMEOUT=120

# How long "winbox up --wait" and "winbox wait" wait for the first SSH answer.
# The first start downloads about 5G of installation media and then installs
# Windows without a human, so the default covers a slow link.
WINDOWS_VM_READY_TIMEOUT=5400

# How long one "winbox exec" may take before ssh gives up on the connection.
WINDOWS_VM_CONNECT_TIMEOUT=10
